/**
 * Проверяет, есть ли ребенок в базе "Клиенты".
 */
function getChildrenNameSet_() {
  const clientsSheet = checkSheetExists(CONSTANTS.SHEET_NAMES.CLIENTS);
  const last = clientsSheet.getLastRow();

  // если кэш актуален — возвращаем сразу
  if (__CHILDREN_CACHE__.set && __CHILDREN_CACHE__.lastRow === last) {
    return __CHILDREN_CACHE__.set;
  }

  if (last < 2) {
    __CHILDREN_CACHE__.set = new Set();
    __CHILDREN_CACHE__.lastRow = last;
    return __CHILDREN_CACHE__.set;
  }

  const values = clientsSheet.getRange(2, 1, last - 1, 1).getValues().flat();
  const s = new Set();
  for (const v of values) {
    const name = String(v || '').trim();
    if (name) s.add(name);
  }

  __CHILDREN_CACHE__.set = s;
  __CHILDREN_CACHE__.lastRow = last;
  return s;
}

function isChildInDatabase(savedCellAddress, activeSheet) {
  const childName = String(activeSheet.getRange(savedCellAddress).getValue() || '').trim();
  if (!childName) return false;

  const set = getChildrenNameSet_();
  return set.has(childName);
}



