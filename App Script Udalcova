/**
 * Находит диапазон с детьми и дату для определенного дня в расписании.
 * @param {string} savedCellAddress - Адрес ячейки, от которой идет поиск.
 * @param {GoogleAppsScript.Spreadsheet.Sheet} activeSheet - Активный лист.
 * @returns {{childrenRange: GoogleAppsScript.Spreadsheet.Range, currentDate: any}|null}
 */
function getChildrenByDate(savedCellAddress, activeSheet) {
    const range = activeSheet.getRange(savedCellAddress);
    const col = range.getColumn();
    const row = range.getRow();

    const allData = activeSheet.getDataRange().getValues();

    // Ищем верхнюю границу (строку со словом "Время")
    let topRowIndex = -1;
    for (let i = row - 1; i >= 0; i--) {
        // Ищем в столбце на 2 левее колонки с детьми
        if (allData[i][col - 3] && String(allData[i][col - 3]).trim() === "Время") {
            topRowIndex = i;
            break;
        }
    }
    if (topRowIndex === -1 || topRowIndex <= 0) {
      logAndAlert('Ошибка', 'Структура нарушена', "Не найдена верхняя граница группы (ячейка 'Время') или она в первой строке.");
      return null;
    }

    // Ищем нижнюю границу (строку со словом "Дата" СЛЕДУЮЩЕЙ группы)
    let bottomRowIndex = allData.length;
    for (let i = topRowIndex + 1; i < allData.length; i++) {
        if (allData[i][col - 3] && String(allData[i][col - 3]).trim() === "Дата") {
            bottomRowIndex = i;
            break;
        }
    }

    // Определяем дату (находится на одну строку выше "Время")
    const currentDate = allData[topRowIndex - 1][col - 2];
    const startRow = topRowIndex + 2; // +1 чтобы перейти на строку ниже "Время", еще +1 для 1-based индексации
    const numRows = bottomRowIndex - (topRowIndex + 1);

    if (numRows <= 0) {
        logAndAlert('Ошибка', 'Нет данных', 'В найденной группе нет строк с детьми.');
        return null;
    }

    const childrenRange = activeSheet.getRange(startRow, col, numRows, 1);

    return {
        childrenRange: childrenRange,
        currentDate: currentDate,
    };
}

/**
 * Добавляет посещения для всех детей за выбранный день и сообщает о детях с нулевой стоимостью.
 */
/**
* Добавляет посещения для всех детей за выбранный день.
* ОПТИМИЗАЦИЯ: пакетная запись одним setValues + пакетная подсветка.
*/
function processDateAttendance(savedCellAddress, activeSheet) {
  const data = getChildrenByDate(savedCellAddress, activeSheet);
  if (!data) return;

  const childrenSet = getChildrenNameSet_();
  const childrenRange = data.childrenRange;
  const childrenValues = childrenRange.getValues();

  const missingCosts = [];
  const allDataToInsert = [];
  const cellsToHighlight = [];

  childrenValues.forEach((row, index) => {
    const childName = row[0];
    if (!childName || typeof childName !== 'string' || childName.trim() === '') return;

    const childCellAddress = childrenRange.getCell(index + 1, 1).getA1Notation();

    if (!childrenSet.has(String(childName).trim())) {
      const response = getUI().alert(
        'Новый ребенок?',
        `Похоже, "${childName}" - новый ребенок.\nДобавить его в базу "Клиенты"?`,
        getUI().ButtonSet.YES_NO
      );
      if (response === getUI().Button.YES) {
        addChildToDatabase(childCellAddress, activeSheet);
        childrenSet.add(String(childName).trim());
      }
    }

    // ⚡ Режим 'collect' — собираем данные без записи
    const result = addAttendance(childCellAddress, null, data.currentDate, activeSheet, 'collect');

    if (result && result.success) {
      if (Array.isArray(result.dataToInsert) && result.dataToInsert.length > 0) {
        allDataToInsert.push(...result.dataToInsert);
        cellsToHighlight.push(childCellAddress);
      }
      if (result.costWasMissing) {
        missingCosts.push({ name: result.childName, service: result.service });
      }
    }
  });

  // === ОДИН вызов setValues для всех строк дня ===
  if (allDataToInsert.length > 0) {
    try {
      const sheet = checkSheetExists(CONSTANTS.SHEET_NAMES.ATTENDANCE);
      const targetRow = sheet.getLastRow() + 1;
      const numCols = allDataToInsert[0].length;
      sheet.getRange(targetRow, 1, allDataToInsert.length, numCols).setValues(allDataToInsert);
      Logger.log(`Пакетно записано ${allDataToInsert.length} строк посещений за день.`);
    } catch (e) {
      logAndAlert('Ошибка', 'Не удалось записать посещения', e.toString());
      return;
    }
  }

  // === Пакетная подсветка ===
  if (cellsToHighlight.length > 0) {
    try {
      const rangeList = activeSheet.getRangeList(cellsToHighlight);
      rangeList.setBackground(CONSTANTS.COLOR_ATTENDED_KID);
    } catch (e) {
      Logger.log(`Не удалось подсветить ячейки: ${e.message}`);
    }
  }

  // === Итоговое сообщение ===
  if (missingCosts.length > 0) {
    let warningMessage = 'Посещения всех детей добавлены.\nВНИМАНИЕ: Для следующих детей не была найдена стоимость услуг (добавлено с 0 руб.):\n';
    missingCosts.forEach(item => {
      warningMessage += `- ${item.name} (услуга: ${item.service})\n`;
    });
    logAndAlert('Завершено с предупреждением', 'Завершено с предупреждением', warningMessage);
  } else {
    logAndAlert('Готово', 'Посещения добавлены', 'Посещения всех детей за данный день успешно добавлены в лист "Посещения".');
  }
}


/**
 * Собирает уникальных педагогов за выбранный день.
 */
function getPedagoguesByDate(savedCellAddress, activeSheet) {
  const range = activeSheet.getRange(savedCellAddress);
  const col = range.getColumn(); // Столбец с педагогом
  const row = range.getRow();
  
  const allData = activeSheet.getDataRange().getValues();

  // Ищем верхнюю границу (строку со словом "Время")
  let topRowIndex = -1;
  for (let i = row - 1; i >= 0; i--) {
    // "Время" находится на 2 столбца левее педагога
    if (allData[i][col - 2] && String(allData[i][col - 2]).trim() === "Время") {
      topRowIndex = i;
      break;
    }
  }
  
  if (topRowIndex === -1) {
    logAndAlert('Ошибка', 'Структура нарушена', "Не найдена верхняя граница группы (ячейка 'Время').");
    return [];
  }

  // Ищем нижнюю границу (строку со словом "Дата" СЛЕДУЮЩЕЙ группы)
  let bottomRowIndex = allData.length;
  for (let i = topRowIndex + 1; i < allData.length; i++) {
    if (allData[i][col - 2] && String(allData[i][col - 2]).trim() === "Дата") {
      bottomRowIndex = i;
      break;
    }
  }

  // Вычисляем диапазон педагогов
  // Первый педагог: строка "Время" + 1
  const startRow = topRowIndex + 1;
  // Последний педагог: строка "Дата" следующей группы - 2
  const numRows = bottomRowIndex - startRow - 1;

  if (numRows <= 0) {
    logAndAlert('Ошибка', 'Нет данных', 'В найденной группе нет строк с педагогами.');
    return [];
  }

  // Получаем все имена педагогов в этом диапазоне
  const pedagogueNamesRaw = activeSheet.getRange(startRow + 1, col, numRows, 1) // +1 для 1-based индексации
    .getValues()
    .flat()
    .filter(cell => {
      const value = String(cell).trim();
      // Исключаем даты и слово "Специалист"
      return value && 
             value !== "Специалист" && 
             value !== "специалист" &&
             !/^\d{1,2}\.\d{1,2}\.\d{4}$/.test(value) && // не дата dd.mm.yyyy
             !/^\d{4}-\d{2}-\d{2}$/.test(value) &&       // не дата yyyy-mm-dd
             !(value instanceof Date);                   // не объект Date
    });

  // Обрабатываем имена (разделяем по "/" и убираем пробелы)
  const uniqueNames = [...new Set(
    pedagogueNamesRaw.flatMap(p => 
      String(p).split('/')
        .map(name => name.trim())
        .filter(name => name && 
                       name !== "Специалист" && 
                       !(name instanceof Date) &&
                       name.length > 1)
    )
  )];

  // Получаем телефоны педагогов
  return uniqueNames.map(name => {
    const phone = findUniversal(CONSTANTS.SHEET_NAMES.STAFF, { 'Имя': name }, 'Телефон');
    return { name, phone };
  });
}

