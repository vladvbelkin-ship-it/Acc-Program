/**
 * Асинхронная версия проверки целостности (вызывается из HTML)
 * @returns {Object} Результаты проверки
 */
function runIntegrityCheckAsync() {
  const result = {
    missingInClients: [],
    missingInBalance: [],
    duplicateVisits: [],
    duplicatePayments: [],
    duplicateClients: [],
    duplicateBalance: []  
  };
  
  try {
    result.missingInClients = findChildrenInScheduleNotInClients();
  } catch (e) {
    Logger.log(`Ошибка проверки "Дети в Расписании": ${e.message}`);
    result.missingInClients = ['Ошибка: ' + e.message];
  }
  
  try {
    result.missingInBalance = findChildrenInClientsNotInBalance();
  } catch (e) {
    Logger.log(`Ошибка проверки "Дети в Клиенты не в Баланс": ${e.message}`);
    result.missingInBalance = ['Ошибка: ' + e.message];
  }
  
  try {
    result.duplicateVisits = findDuplicateRowsInSheet('Посещения', [3]);
  } catch (e) {
    Logger.log(`Ошибка проверки дублей в Посещения: ${e.message}`);
    result.duplicateVisits = [{ rows: 'Ошибка', content: e.message }];
  }
  
  try {
    result.duplicatePayments = findDuplicateRowsInSheet('Оплаты', [1]);
  } catch (e) {
    Logger.log(`Ошибка проверки дублей в Оплаты: ${e.message}`);
    result.duplicatePayments = [{ rows: 'Ошибка', content: e.message }];
  }
  
  try {
    result.duplicateClients = findDuplicateNamesInClients();
  } catch (e) {
    Logger.log(`Ошибка проверки дублей в Клиенты: ${e.message}`);
    result.duplicateClients = [{ rows: 'Ошибка', content: e.message }];
  }
  
  try {
    result.duplicateBalance = findDuplicateNamesInBalance();
  } catch (e) {
    Logger.log(`Ошибка проверки дублей в Баланс: ${e.message}`);
    result.duplicateBalance = [{ rows: 'Ошибка', content: e.message }];
  }
  
  return result;
}

/**
 * Находит детей в Расписании, которых нет в листе Клиенты
 * @returns {Array<string>} Список имен детей
 */
function findChildrenInScheduleNotInClients() {
  const scheduleSheet = SPREADSHEET.getSheetByName(CONSTANTS.SHEET_NAMES.SCHEDULE);
  if (!scheduleSheet) {
    throw new Error('Лист "Расписание" не найден');
  }
  
  const lastRow = scheduleSheet.getLastRow();
  const lastCol = scheduleSheet.getLastColumn();
  if (lastRow < 2 || lastCol < 4) {
    return [];
  }
  
  const allData = scheduleSheet.getRange(1, 1, lastRow, lastCol).getValues();
  const childrenSet = getChildrenNameSet_();
  const missingChildren = new Set();
  
  // Ищем все "Дата" по всему листу
  for (let r = 0; r < allData.length; r++) {
    for (let c = 0; c < allData[r].length; c++) {
      if (String(allData[r][c]).trim() !== 'Дата') continue;
      
      const timeHeaderRow = findTimeHeaderRow_(allData, r, c);
      if (timeHeaderRow === -1) continue;
      
      const childCol = c + 2;
      if (childCol >= lastCol) continue;
      
      const startRow = timeHeaderRow + 1;
      const endRowExclusive = findNextDateRowInColumn_(allData, c, timeHeaderRow + 1);
      
      for (let rr = startRow; rr < endRowExclusive; rr++) {
        const childName = safeCellStr_(allData, rr, childCol);
        if (!childName) continue;
        if (/перерыв|пауза|окно|отдых/i.test(childName)) continue;
        
        // Проверяем, есть ли ребенок в базе Клиенты
        if (!childrenSet.has(childName)) {
          missingChildren.add(childName);
        }
      }
    }
  }
  
  return Array.from(missingChildren).sort();
}

/**
 * Находит детей в Клиенты, которых нет в Баланс
 * @returns {Array<string>} Список имен детей
 */
function findChildrenInClientsNotInBalance() {
  const clientsSheet = checkSheetExists(CONSTANTS.SHEET_NAMES.CLIENTS);
  const balanceSheet = checkSheetExists(CONSTANTS.SHEET_NAMES.BALANCE);
  
  // Получаем всех детей из Клиенты
  const clientsLastRow = clientsSheet.getLastRow();
  if (clientsLastRow < 2) return [];
  
  const clientsData = clientsSheet.getRange(2, 1, clientsLastRow - 1, 1).getValues();
  const clientsSet = new Set();
  clientsData.forEach(row => {
    const name = String(row[0] || '').trim();
    if (name) clientsSet.add(name);
  });
  
  // Получаем всех детей из Баланс
  const balanceLastRow = balanceSheet.getLastRow();
  if (balanceLastRow < 2) return Array.from(clientsSet).sort();
  
  const balanceData = balanceSheet.getRange(2, 1, balanceLastRow - 1, 1).getValues();
  const balanceSet = new Set();
  balanceData.forEach(row => {
    const name = String(row[0] || '').trim();
    if (name) balanceSet.add(name);
  });
  
  // Находим детей, которые есть в Клиенты, но нет в Баланс
  const missing = [];
  clientsSet.forEach(name => {
    if (!balanceSet.has(name)) {
      missing.push(name);
    }
  });
  
  return missing.sort();
}

/**
 * Находит дублирующиеся строки в указанном листе по ключевым столбцам
 * @param {string} sheetName - Имя листа
 * @param {Array<number>} keyColumns - Индексы столбцов (0-based) для сравнения
 * @returns {Array<{rows: string, content: string}>} Массив с информацией о дублях
 */
function findDuplicateRowsInSheet(sheetName, keyColumns) {
  const sheet = SPREADSHEET.getSheetByName(sheetName);
  if (!sheet) {
    throw new Error(`Лист "${sheetName}" не найден`);
  }
  
  const lastRow = sheet.getLastRow();
  if (lastRow < 2) return [];
  
  // Получаем ВСЕ данные
  const data = sheet.getRange(2, 1, lastRow - 1, sheet.getLastColumn()).getValues();
  
  // Создаем карту: ключ -> [номера строк, ...]
  const map = new Map();
  
  data.forEach((row, index) => {
    // Создаем ключ из всех столбцов для полного сравнения
    const fullRowKey = row.map(cell => String(cell || '').trim()).join('|||');
    
    if (!map.has(fullRowKey)) {
      map.set(fullRowKey, {
        rows: [],
        content: row.map(cell => String(cell || '').trim()).join(' | ')
      });
    }
    map.get(fullRowKey).rows.push(index + 2); // +2 потому что данные начинаются со строки 2
  });
  
  // Собираем дубли (где больше 1 строки)
  const duplicates = [];
  map.forEach((value, key) => {
    if (value.rows.length > 1) {
      duplicates.push({
        rows: value.rows.join(', '),
        content: value.content
      });
    }
  });
  
  return duplicates;
}

/**
 * Находит дубли по комбинации (Имя, Группа/Индива, Услуга) в листе Клиенты
 * @returns {Array<{rows: string, childName: string, groupType: string, service: string}>} 
 *          Массив с информацией о дублях
 */
function findDuplicateNamesInClients() {
  const clientsSheet = checkSheetExists(CONSTANTS.SHEET_NAMES.CLIENTS);
  const lastRow = clientsSheet.getLastRow();
  if (lastRow < 2) return [];
  
  // Получаем заголовки из ВТОРОЙ строки (строка 2)
  const headersRow = clientsSheet.getRange(2, 1, 1, clientsSheet.getLastColumn()).getValues()[0];
  
  // Нормализуем заголовки: убираем переносы строк и лишние пробелы
  const normalizedHeaders = headersRow.map(h => {
    if (!h) return '';
    return String(h).replace(/\n/g, ' ').replace(/\s+/g, ' ').trim();
  });
  
  // Ищем нужные столбцы по нормализованным названиям
  const nameColIdx = normalizedHeaders.findIndex(h => h === 'Имя');
  
  // Ищем "Группа/Индива" с учетом возможных переносов и пробелов
  let groupColIdx = normalizedHeaders.findIndex(h => h === 'Группа / Индива' || h === 'Группа/Индива');
  if (groupColIdx === -1) {
    groupColIdx = normalizedHeaders.findIndex(h => h.includes('Группа') && h.includes('Индива'));
  }
  if (groupColIdx === -1) {
    groupColIdx = normalizedHeaders.findIndex(h => h.includes('Групп'));
  }
  
  // Ищем "Услуга"
  let serviceColIdx = normalizedHeaders.findIndex(h => h === 'Услуга');
  if (serviceColIdx === -1) {
    serviceColIdx = normalizedHeaders.findIndex(h => h.includes('Услуг'));
  }
  
  // Проверяем, что все нужные столбцы найдены
  if (nameColIdx === -1) {
    throw new Error('Столбец "Имя" не найден в листе Клиенты');
  }
  if (groupColIdx === -1) {
    throw new Error('Столбец "Группа/Индива" не найден в листе Клиенты');
  }
  if (serviceColIdx === -1) {
    throw new Error('Столбец "Услуга" не найден в листе Клиенты');
  }
  
  // Получаем данные (со строки 3 до последней, потому что строка 2 - заголовки)
  const data = clientsSheet.getRange(3, 1, lastRow - 2, clientsSheet.getLastColumn()).getValues();
  
  // Карта: ключ (Имя|Группа/Индива|Услуга) -> [номера строк, ...]
  const map = new Map();
  
  data.forEach((row, index) => {
    const childName = String(row[nameColIdx] || '').trim();
    const groupType = String(row[groupColIdx] || '').trim();
    const service = String(row[serviceColIdx] || '').trim();
    
    // Пропускаем пустые строки
    if (!childName) return;
    
    // Создаем уникальный ключ из трех полей
    const key = `${childName}|||${groupType}|||${service}`;
    
    if (!map.has(key)) {
      map.set(key, {
        rows: [],
        childName: childName,
        groupType: groupType || '(не указано)',
        service: service || '(не указано)'
      });
    }
    map.get(key).rows.push(index + 3); // +3 потому что данные начинаются со строки 3
  });
  
  // Собираем дубли (где больше 1 строки)
  const duplicates = [];
  map.forEach((value, key) => {
    if (value.rows.length > 1) {
      duplicates.push({
        rows: value.rows.join(', '),
        childName: value.childName,
        groupType: value.groupType || '(не указано)',
        service: value.service || '(не указано)'
      });
    }
  });
  
  // Сортируем по имени ребенка
  duplicates.sort((a, b) => a.childName.localeCompare(b.childName));
  
  return duplicates;
}

/**
 * Находит дубли по имени в листе Баланс
 * @returns {Array<{rows: string, childName: string}>} 
 *          Массив с информацией о дублях
 */
function findDuplicateNamesInBalance() {
  const balanceSheet = checkSheetExists(CONSTANTS.SHEET_NAMES.BALANCE);
  const lastRow = balanceSheet.getLastRow();
  if (lastRow < 2) return [];
  
  // Получаем данные (со строки 2 до последней)
  // Столбец A - Имя ребенка
  const data = balanceSheet.getRange(2, 1, lastRow - 1, 1).getValues();
  
  // Карта: имя -> [номера строк, ...]
  const map = new Map();
  
  data.forEach((row, index) => {
    const childName = String(row[0] || '').trim();
    
    // Пропускаем пустые строки
    if (!childName) return;
    
    if (!map.has(childName)) {
      map.set(childName, {
        rows: [],
        childName: childName
      });
    }
    map.get(childName).rows.push(index + 2); // +2 потому что данные начинаются со строки 2
  });
  
  // Собираем дубли (где больше 1 строки)
  const duplicates = [];
  map.forEach((value, key) => {
    if (value.rows.length > 1) {
      duplicates.push({
        rows: value.rows.join(', '),
        childName: value.childName
      });
    }
  });
  
  // Сортируем по имени ребенка
  duplicates.sort((a, b) => a.childName.localeCompare(b.childName));
  
  return duplicates;
}

