/**
 *копирует лист Расписание, дает ему имя в соответствие диапазона дат текущец недели в расписании
 */
function copyScheduleSheetWithDateRange() {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const sheet = ss.getSheetByName("Расписание");
  if (!sheet) {
    throw new Error("Лист 'Расписание' не найден.");
  }

  const maxRows = 30;
  const maxCols = 12; // Столбец L — это 12-й
  const data = sheet.getRange(1, 1, maxRows, maxCols).getValues();

  const dates = [];

  for (let row = 0; row < data.length; row++) {
    for (let col = 0; col < data[row].length - 1; col++) {
      const cellValue = data[row][col];
      if (typeof cellValue === 'string' && cellValue.toLowerCase().includes('дата')) {
        const dateCell = data[row][col + 1];
        if (dateCell instanceof Date && !isNaN(dateCell.getTime())) {
          dates.push(dateCell);
        }
      }
    }
  }

  if (dates.length === 0) {
    throw new Error("Не найдены даты рядом с ячейками, содержащими 'Дата'.");
  }

  // Найдем минимальную и максимальную дату
  const minDate = new Date(Math.min(...dates));
  const maxDate = new Date(Math.max(...dates));

  // Форматирование дат
  const formatDate = (d) => Utilities.formatDate(d, Session.getScriptTimeZone(), "dd.MM.yy");
  const newSheetName = `${formatDate(minDate)}-${formatDate(maxDate)}`;

  // Проверка, существует ли уже лист с таким именем
  if (ss.getSheetByName(newSheetName)) {
    throw new Error(`Лист с именем '${newSheetName}' уже существует.`);
  }

  // Копируем лист и переименовываем
  const copiedSheet = sheet.copyTo(ss).setName(newSheetName);

// Вставить новый лист сразу после оригинального листа "Расписание"
const allSheets = ss.getSheets();
const scheduleIndex = allSheets.findIndex(s => s.getName() === "Расписание");
ss.setActiveSheet(copiedSheet);
ss.moveActiveSheet(scheduleIndex + 2);  // +2, потому что индексация с 1

  Logger.log(`Создана копия листа 'Расписание' с именем '${newSheetName}'.`);
}



