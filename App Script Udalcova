/**
 * Считает количество детей, занятий и пропусков на текущей неделе в листе "Расписание".
 * Результаты выводятся на лист "Клиенты".
 */
function calculateWeeklyStats() {
  try {
    const scheduleSheet = SPREADSHEET.getSheetByName(CONSTANTS.SHEET_NAMES.SCHEDULE);
    if (!scheduleSheet) {
      getUI().alert('Ошибка', 'Лист "Расписание" не найден.', getUI().ButtonSet.OK);
      return;
    }

    const lastRow = scheduleSheet.getLastRow();
    const lastCol = scheduleSheet.getLastColumn();

    if (lastRow < 2 || lastCol < 4) {
      getUI().alert('Информация', 'Лист "Расписание" пустой или структура слишком маленькая.', getUI().ButtonSet.OK);
      return;
    }

    const allData = scheduleSheet.getRange(1, 1, lastRow, lastCol).getValues();

    const uniqueChildren = new Set();
    let totalLessons = 0;
    let totalAbsences = 0;
    const absencesDetails = [];

    const absenceRe = ABSENCE_RE;

    // Ищем все "Дата" по всему листу
    for (let r = 0; r < allData.length; r++) {
      for (let c = 0; c < allData[r].length; c++) {
        if (String(allData[r][c]).trim() !== 'Дата') continue;

        // дата справа
        const rawDateValue = (c + 1 < lastCol) ? allData[r][c + 1] : null;
        const rawDateStr = String(rawDateValue ?? '').trim();
        if (!rawDateStr) continue;

        const dateObj = normalizeDate_(rawDateValue);
        if (!dateObj) continue;

        const formattedDate = Utilities.formatDate(
          dateObj,
          SPREADSHEET.getSpreadsheetTimeZone(),
          "dd.MM.yyyy"
        );

        // строка "Время" под блоком
        const timeHeaderRow = findTimeHeaderRow_(allData, r, c);
        if (timeHeaderRow === -1) continue;

        // колонки блока
        const childCol = c + 2;
        const serviceCol = c + 3;

        if (childCol >= lastCol) continue;

        const startRow = timeHeaderRow + 1;
        const endRowExclusive = findNextDateRowInColumn_(allData, c, startRow);

        for (let rr = startRow; rr < endRowExclusive; rr++) {
          const childRaw = safeCellStr_(allData, rr, childCol);
          if (!childRaw) continue;

          // служебные строки (но оставляем "отмена" как возможную причину отсутствия)
          if (/перерыв|пауза|окно|отдых/i.test(childRaw)) continue;

          let serviceRaw = '';
          if (serviceCol < lastCol) serviceRaw = safeCellStr_(allData, rr, serviceCol);

          // ребёнок считается записанным (занятие)
          uniqueChildren.add(childRaw);
          totalLessons++;

          // определяем пропуск
          const serviceNorm = normalizeTextForMatch_(serviceRaw);
          const childNorm = normalizeTextForMatch_(childRaw);

          let isAbsent = false;
          let reason = '';
          let reasonSource = '';

          if (serviceNorm && absenceRe.test(serviceNorm)) {
            isAbsent = true;
            reason = serviceRaw;
            reasonSource = 'service';
          } else if (childNorm && absenceRe.test(childNorm)) {
            isAbsent = true;
            reason = childRaw;
            reasonSource = 'child';
          }

          if (isAbsent) {
            totalAbsences++;
            absencesDetails.push({
              date: formattedDate,
              child: childRaw,
              reason: reason,
              source: reasonSource
            });
          }
        }
      }
    }

// Формируем сообщение для вывода

let message = `━━━━━━━━━━━━━━━━━━━━━━━\n\n`;

const totalPresent = totalLessons - totalAbsences;

message += `Количество детей: ${uniqueChildren.size}\n`;
message += `Общее количество занятий: ${totalLessons}\n`;
message += `Состоялось: ${totalPresent}\n`;
message += `Не состоялось: ${totalAbsences}\n`;
    
    if (totalLessons > 0) {
      const attendanceRate = ((totalLessons - totalAbsences) / totalLessons * 100).toFixed(1);
      message += `✅ Посещаемость: ${attendanceRate}%\n`;
    }
    
    // Добавляем детализацию пропусков, если они есть
    if (absencesDetails.length > 0) {
      message += `\n📋 ДЕТАЛИ ПРОПУСКОВ:\n`;
      message += `━━━━━━━━━━━━━━━━━━━━━━━\n`;
      
      absencesDetails.forEach((absence, index) => {
        message += `\n${index + 1}. ${absence.date} | ${absence.child} | ${absence.reason}`;
      });
    } else {
      message += `\n✨ Пропусков не обнаружено!\n`;
    }
    
    message += `\n━━━━━━━━━━━━━━━━━━━━━━━\n`;
    message += `🕐 ${new Date().toLocaleString()}`;

    // Выводим результаты в окно
    getUI().alert('Статистика занятий', message, getUI().ButtonSet.OK);

    // Для отладки (можно удалить)
    Logger.log(`Всего занятий: ${totalLessons}`);
    Logger.log(`Всего пропусков: ${totalAbsences}`);

  } catch (error) {
    logAndAlert('Ошибка', 'Не удалось посчитать статистику', error.toString());
  }
}

/**
 * Нормализация текста для матчинга:
 * - null/undefined -> ''
 * - trim
 * - lower
 * - ё -> е
 * - схлопнуть пробелы/переносы
 */
function normalizeTextForMatch_(v) {
  const s = String(v ?? '').trim();
  if (!s) return '';
  return s
    .toLowerCase()
    .replace(/ё/g, 'е')
    .replace(/\s+/g, ' ')
    .trim();
}

/**
 * Максимально широкий regex по отсутствиям:
 * Болезнь / неявка / отмена / перенос / "не будет" / "у врача" и т.п.
 *
 * Важно: НЕ включаем сюда слова услуг типа "смк", "нейромасс" и т.д.
 */
function buildAbsenceRegex_() {
  // Блоки шаблонов — легко расширять
  const patterns = [
    // Болезнь
    'забол\\w*',            // заболел/заболела/заболели/заболел(и)
    'боле\\w*',             // болеет/болел/болела
    'простуд\\w*',
    'температур\\w*',
    'кашл\\w*',
    'сопл\\w*',
    'орви|грипп|ангин\\w*',
    'карантин\\w*',
    'врач\\w*|к\\s*врач\\w*|у\\s*врач\\w*|поликлин\\w*|больниц\\w*',

    // Неявка / не придет
    'не\\s*прид[её]т',
    'не\\s*приду\\b',
    'не\\s*приш[её]л',
    'не\\s*пришл\\w*',
    'не\\s*сможет',
    'не\\s*смог\\w*',
    'не\\s*будет',
    'не\\s*получ(ится|илось|ится)',
    'не\\s*выходит',

    // Пропуски / отсутствие
    'пропуск\\w*',
    'пропуст\\w*',
    'отсутств\\w*',         // отсутствовал/отсутствует/отсутствие
    'не\\s*был\\w*',         // не было / не был / не была
    'не\\s*будет',           // отдельно оставляем — часто пишут кратко

    // Отмена / перенос
    'отмен\\w*',             // отмена/отменили/отменен
    'перенос\\w*|перенес\\w*|перен[её]с\\w*',
    'сорвал\\w*',
    'не\\s*получилось',

    // “Нет занятия”
    'занят\\w*\\s*не\\s*будет',
    'не\\s*занима\\w*',
    
    // Каникулы и производные
    'каникул\\w*',           // каникулы/каникулах/каникулярный
    
    // Отпуск и производные
    'отпуск\\w*'             // отпуск/отпуска/отпускной
];

  // Собираем в один regex: ищем ВХОЖДЕНИЕ где угодно
  // (без якорей, чтобы ловить фразы типа "отмена, идут к врачу")
  const source = '(' + patterns.join('|') + ')';
  return new RegExp(source, 'i');
}

/**
* Предрассчитанная регулярка для определения пропусков/отмен/болезней.
* Строится ОДИН РАЗ при загрузке скрипта и переиспользуется во всех вызовах.
* Логика матчинга НЕ изменена — это та же регулярка, что возвращала buildAbsenceRegex_().
* @type {RegExp}
*/
const ABSENCE_RE = buildAbsenceRegex_();


/**
 * Находит время занятия, двигаясь вверх от ячейки ребенка.
 * Оптимизировано: читает 1 столбец за один раз.
 */
function findClassTime(savedCellAddress, activeSheet) {
  const range = activeSheet.getRange(savedCellAddress);
  const row = range.getRow();
  const col = range.getColumn() - 2;
  if (col < 1) return null;

  const columnData = activeSheet.getRange(1, col, row, 1).getValues();
  for (let i = columnData.length - 1; i >= 0; i--) {
    if (columnData[i][0]) {
      return columnData[i][0];
    }
  }
  return null;
}

