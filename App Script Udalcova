/**
 * Запускает процесс сбора, форматирования и отображения данных.
 */
function runExportProcess() {
  const SPREADSHEET = SpreadsheetApp.getActiveSpreadsheet();
  const UI = SpreadsheetApp.getUi();

  const sheet = SPREADSHEET.getActiveSheet();
  const selection = sheet.getSelection();

  if (!selection) {
    getUI().alert('❌ Сначала выделите ячейки для экспорта.');
    return;
  }

  const rangeList = selection.getActiveRangeList();
  if (!rangeList || rangeList.getRanges().length === 0) {
    getUI().alert('❌ Выделите хотя бы один диапазон ячеек!');
    return;
  }

  let allRows = [];
  for (const range of rangeList.getRanges()) {
    const visibleData = getVisibleValuesFromRange(range);
    if (visibleData.length > 0) {
      allRows = allRows.concat(visibleData);
    }
  }

  if (allRows.length === 0) {
    getUI().alert('В выделенных диапазонах нет видимых данных для экспорта.');
    return;
  }
  
  // 1. Создаем визуальную таблицу для Telegram
  const visualTable = createVisualTelegramTable(allRows);
  
  // 2. Создаем CSV-текст для Excel
  const excelCsv = createSemicolonCsv(allRows);
  
  // Показываем диалоговое окно с одной кнопкой копирования
  showExportDialog(visualTable, excelCsv);
}

/**
 * Создает визуально ровную таблицу для Telegram.
 * @param {Array<Array<string>>} rows Двумерный массив с данными.
 * @returns {string} Отформатированная строка для вставки в Telegram.
 */
function createVisualTelegramTable(rows) {
  const cleanRows = rows.map(row =>
    row.map(cell => {
      // ВАЖНО: 0 должен оставаться "0", иначе его съест (cell || '')
      const cellStr = (cell === 0) ? '0' : String(cell ?? '').trim();
      return cellStr.replace(/\n/g, ' ');
    })
  );

  let totalSum = 0;
  const lastColIndex = cleanRows[0].length - 1;
  for (let i = 1; i < cleanRows.length; i++) {
    if (cleanRows[i].length > lastColIndex) {
      const num = parseNumber(cleanRows[i][lastColIndex]);
      if (!isNaN(num)) {
        totalSum += num;
      }
    }
  }
  const totalText = `Итого: ${formatNumber(totalSum)}`;

  const columnWidths = new Array(lastColIndex + 1).fill(0);
  for (const row of cleanRows) {
    for (let i = 0; i < row.length; i++) {
      if (row[i].length > columnWidths[i]) {
        columnWidths[i] = row[i].length;
      }
    }
  }

  const resultRows = [];
  const separator = '  ';
  const rowFormatter = (row) => row.map((cell, i) => {
  // последний столбец (Сумма) — вправо
    if (i === columnWidths.length - 1) {
      return ' '.repeat(columnWidths[i] - cell.length) + cell;
    }
    // остальные — влево
    return cell + ' '.repeat(columnWidths[i] - cell.length);
  }).join(separator);

  resultRows.push(rowFormatter(cleanRows[0]));
  resultRows.push(columnWidths.map(width => '-'.repeat(width)).join(separator));

  for (let i = 1; i < cleanRows.length; i++) {
    resultRows.push(rowFormatter(cleanRows[i]));
  }
  
  if (totalSum > 0) {
    const totalWidth = columnWidths.reduce((a, b) => a + b, 0) + (separator.length * (columnWidths.length - 1));
    resultRows.push(' '.repeat(Math.max(0, totalWidth - totalText.length)) + totalText);
  }

  return '```\n' + resultRows.join('\n') + '\n```';
}

/**
 * Извлекает значения только из видимых строк и столбцов.
 */
function getVisibleValuesFromRange(range) {
  const sheet = range.getSheet();
  const startRow = range.getRow(), startCol = range.getColumn();
  const numRows = range.getNumRows(), numCols = range.getNumColumns();
  const allDisplayValues = range.getDisplayValues();

  const visibleColumnIndexes = [];
  for (let c = 0; c < numCols; c++) {
    if (!sheet.isColumnHiddenByUser(startCol + c)) {
      visibleColumnIndexes.push(c);
    }
  }
  if (visibleColumnIndexes.length === 0) return [];

  const visibleRows = [];
  for (let r = 0; r < numRows; r++) {
    const absoluteRowIndex = startRow + r;
    if (!sheet.isRowHiddenByFilter(absoluteRowIndex) && !sheet.isRowHiddenByUser(absoluteRowIndex)) {
      visibleRows.push(visibleColumnIndexes.map(colIndex => allDisplayValues[r][colIndex]));
    }
  }
  return visibleRows;
}

