 * Используется для открытия в новом окне
 */
function getReportHtmlForChild(childName) {
  try {
    Logger.log('getReportHtmlForChild вызвана с именем: ' + childName);
    
    // Генерируем отчет
    const report = generateChildReport(childName);
    
    if (!report || report.records.length === 0) {
      return createErrorHtml(`Для ребенка "${childName}" не найдено данных о посещениях и оплатах.`);
    }
    
    // Формируем таблицы
    const visualTable = formatReportAsTable(report);
    const csvData = formatReportAsCSV(report);
    
    // Получаем данные родителей
    const parentData = findParentNamesByKidNameByExactName(childName);
    
    // Создаем HTML для нового окна
    return createReportHtml(childName, visualTable, csvData, parentData);
    
  } catch (error) {
    return createErrorHtml(error.toString());
  }
}

