// --- Форматирование отчета как таблицы (выравнивание чисел по правому краю, без итоговой строки) ---
/**
 * Форматирует отчет как ровную таблицу с выравниванием.
 * Столбцы: Дата, Услуга, Сумма (вправо), Баланс (вправо)
 * @param {Object} report - Отчет, сгенерированный generateChildReport()
 * @returns {string} Отформатированная таблица
 */
/**
 * Форматирует отчет как ровную таблицу с выравниванием.
 * Столбцы: Дата, Услуга, Сумма (вправо), Баланс (вправо)
 * @param {Object} report - Отчет, сгенерированный generateChildReport()
 * @returns {string} Отформатированная таблица в моноширинном блоке
 */
function formatReportAsTable(report) {
  const records = report.records;
  
  if (records.length === 0) {
    return "Нет данных для отображения";
  }
  
  // Формируем строки данных
  const rows = [];
  
  for (const record of records) {
    const dateStr = Utilities.formatDate(record.date, Session.getScriptTimeZone(), 'dd.MM.yyyy');
    const service = record.service;
    
    let amountDisplay;
    if (record.isPayment) {
      amountDisplay = `+${formatNumberNoSpaces(record.rawAmount)}`;
    } else {
      amountDisplay = `-${formatNumberNoSpaces(record.rawAmount)}`;
    }
    const balanceDisplay = formatNumberNoSpaces(record.balance);
    
    rows.push([dateStr, service, amountDisplay, balanceDisplay]);
  }
  
  // Определяем максимальную ширину каждого столбца
  const colWidths = [0, 0, 0, 0];
  
  // Заголовки
  const headers = ['Дата', 'Услуга', 'Сумма', 'Баланс'];
  colWidths[0] = headers[0].length;
  colWidths[1] = headers[1].length;
  colWidths[2] = headers[2].length;
  colWidths[3] = headers[3].length;
  
  // Данные
  for (const row of rows) {
    for (let i = 0; i < row.length; i++) {
      const cellLength = String(row[i]).length;
      if (cellLength > colWidths[i]) {
        colWidths[i] = cellLength;
      }
    }
  }
  
  // Формируем строки с выравниванием
  const tableLines = [];
  
  // Заголовок (все влево)
  tableLines.push(
    headers.map((h, i) => h.padEnd(colWidths[i])).join('  ')
  );
  
  // Разделитель
  tableLines.push(
    colWidths.map(w => '-'.repeat(w)).join('  ')
  );
  
  // Данные: Дата и Услуга влево, Сумма и Баланс вправо
  for (const row of rows) {
    const dateCol = row[0].padEnd(colWidths[0]);
    const serviceCol = row[1].padEnd(colWidths[1]);
    const amountCol = row[2].padStart(colWidths[2]);     // вправо
    const balanceCol = row[3].padStart(colWidths[3]);    // вправо
    
    tableLines.push(`${dateCol}  ${serviceCol}  ${amountCol}  ${balanceCol}`);
  }
  
  // Оборачиваем в моноширинный блок (для Telegram)
  // ВАЖНО: ``` должны быть на ОТДЕЛЬНЫХ строках!
  return '```\n' + tableLines.join('\n') + '\n```';
}

// Новая вспомогательная функция - форматирование чисел БЕЗ ПРОБЕЛОВ
function formatNumberNoSpaces(num) {
  if (num === undefined || num === null) return "0";
  if (typeof num === 'string') {
    const parsed = parseFloat(num.replace(',', '.'));
    if (isNaN(parsed)) return "0";
    num = parsed;
  }
  if (!isFinite(num)) return "0";
  
  // Округляем до целых (без копеек)
  num = Math.round(num);
  
  // Форматируем без пробелов - просто число как строку
  return num.toString();
}

// --- Форматирование отчета как CSV (без итоговой строки) ---
function formatReportAsCSV(report) {
  const records = report.records;
  
  if (records.length === 0) {
    return "Нет данных для отображения";
  }
  
  // Создаем заголовки
  const headers = ['Дата', 'Услуга', 'Сумма', 'Баланс'];
  
  // Создаем строки данных (без итоговой строки)
  const data = records.map(record => {
    const dateStr = Utilities.formatDate(record.date, Session.getScriptTimeZone(), 'dd.MM.yyyy');
    const service = record.service;
    
    // Для CSV используем числовые значения с правильным знаком
    const amount = record.isPayment ? record.rawAmount : -record.rawAmount;
    const balance = record.balance;
    
    return [dateStr, service, amount, balance];
  });
  
  // Используем существующую функцию для создания CSV
  const allRows = [headers, ...data];
  return createSemicolonCsv(allRows);
}

// --- Вспомогательная функция для форматирования чисел ---
function formatNumber(num) {
  if (num === undefined || num === null) return "0";
  if (typeof num === 'string') {
    // Пытаемся преобразовать строку в число
    const parsed = parseFloat(num.replace(',', '.'));
    if (isNaN(parsed)) return "0";
    num = parsed;
  }
  if (!isFinite(num)) return "0";
  
  // Форматируем число с 2 знаками после запятой
  return num.toLocaleString('ru-RU', { 
    minimumFractionDigits: 0,
    maximumFractionDigits: 2 
  });
}

// --- Функция генерации отчета по ребенку (исправленная) ---
function generateChildReport(childName) {
  const ss = SPREADSHEET;
  const visitsSheet = ss.getSheetByName('Посещения');
  const paymentsSheet = ss.getSheetByName('Оплаты');


  // === ДИАГНОСТИКА ===
  Logger.log("=== ДИАГНОСТИКА generateChildReport ===");
  Logger.log("Лист 'Посещения' найден: " + (visitsSheet !== null));
  if (visitsSheet !== null) {
    Logger.log("Последняя строка 'Посещения': " + visitsSheet.getLastRow());
    Logger.log("Название листа: " + visitsSheet.getName());
  }
  
  Logger.log("Лист 'Оплаты' найден: " + (paymentsSheet !== null));
  if (paymentsSheet !== null) {
    Logger.log("Последняя строка 'Оплаты': " + paymentsSheet.getLastRow());
    Logger.log("Название листа: " + paymentsSheet.getName());
  }
  Logger.log("Имя ребенка для поиска: " + childName);
  // === КОНЕЦ ДИАГНОСТИКИ ===
  
  // Получаем все данные

  const vLast = visitsSheet.getLastRow();
  const pLast = paymentsSheet.getLastRow();

  const visitsData = (vLast >= 2) ? visitsSheet.getRange(2, 1, vLast - 1, 11).getValues() : [];
  const paymentsData = (pLast >= 2) ? paymentsSheet.getRange(2, 1, pLast - 1, 4).getValues() : [];
  const records = [];
  
  // Обрабатываем посещения (отрицательные суммы)
  visitsData.forEach(row => {
    if (row[3] === childName) { // Имя ребенка в столбце D
      const date = row[0];
      const service = row[7] || 'Не указано'; // Услуга в столбце H
      const amount = row[4] || 0; // Стоимость занятия
      
      // Проверяем, что date - это дата
      const dateObj = toDateAny_(date);
      if (!dateObj) return; // пропускаем строку, если дата не распознана
      
      records.push({
        date: dateObj,
        type: 'Занятие',
        service: service,
        amount: -amount, // Отрицательное значение для занятия
        rawAmount: amount,
        isPayment: false
      });
    }
  });
  
  // Обрабатываем оплаты (положительные суммы)
  paymentsData.forEach(row => {
    if (row[1] === childName) { // Имя ребенка в столбце B
      const date = row[0];
      const amount = row[3] || 0; // Сумма оплаты
      
      // Проверяем, что date - это дата
      const dateObj = toDateAny_(date);
      if (!dateObj) return; // пропускаем строку, если дата не распознана
      
      records.push({
        date: dateObj,
        type: 'Оплата',
        service: 'Опл.',
        amount: amount, // Положительное значение для оплаты
        rawAmount: amount,
        isPayment: true
      });
    }
  });
  
  // Сортируем по дате (от старых к новым)
  records.sort((a, b) => a.date - b.date);
  
  // Рассчитываем сквозной баланс
  let runningBalance = 0;
  records.forEach(record => {
    runningBalance += record.amount;
    record.balance = runningBalance;
  });
  
  const totalBalance = records.length > 0 ? records[records.length - 1].balance : 0;
  Logger.log("generateChildReport завершилась " + childName);
  return {
    childName: childName,
    records: records,
    totalBalance: totalBalance,
    startDate: records.length > 0 ? records[0].date : null,
    endDate: records.length > 0 ? records[records.length - 1].date : null
  };
}

/**
 * Создает текст, где столбцы разделены точкой с запятой, ВКЛЮЧАЯ ЗАГОЛОВОК.
 * @param {Array<Array<string>>} rows Двумерный массив с данными.
 * @returns {string} Текст в формате CSV с разделителем ";".
 */
function createSemicolonCsv(rows) {
  return rows.map(row =>
    row.map(cell => {
      // Очищаем от переносов как в createVisualTelegramTable
      let cellStr = String(cell || '').trim().replace(/\n/g, ' ');
      
      // Обрабатываем 0
      if (cell === 0 || cell === '0') {
        cellStr = '0';
      }
      
      // Для числовых значений убираем все пробелы
      if (typeof cell === 'number' || (typeof cell === 'string' && /^[\d\s\u00A0,.]+$/.test(cell))) {
        cellStr = cellStr.replace(/[\s\u00A0]/g, '');
      }
      
      // Экранируем если нужно
      if (cellStr.includes(';') || cellStr.includes('"') || cellStr.includes('\n')) {
        cellStr = '"' + cellStr.replace(/"/g, '""') + '"';
      }
      return cellStr;
    }).join(';')
  ).join('\n');
}

