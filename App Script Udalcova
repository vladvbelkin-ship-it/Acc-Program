function generateSalaryReport_(empName, dateFrom, dateTo) {
  const visitsSheet = checkSheetExists(CONSTANTS.SHEET_NAMES.ATTENDANCE); // "Посещения"
  const lastRow = visitsSheet.getLastRow();
  if (lastRow < 2) return { rows: [['Дата','Имя ребенка','Услуга','Сумма']] };

  const data = visitsSheet.getRange(2, 1, lastRow - 1, 11).getValues();

  const rows = [['Дата', 'Имя ребенка', 'Услуга', 'Сумма']];

  const fromMs = dateFrom ? new Date(dateFrom.getFullYear(), dateFrom.getMonth(), dateFrom.getDate()).getTime() : null;
  const toMs   = dateTo   ? new Date(dateTo.getFullYear(),   dateTo.getMonth(),   dateTo.getDate()).getTime()   : null;

  for (const r of data) {
    const rowDate = r[0];
    const child   = r[3];
    const service = r[7];
    const salary  = r[9];
    const who     = r[5];

    if (String(who || '').trim() !== empName) continue;

    // дата в "Посещения" обычно строкой dd.MM.yy; приводим к Date через normalizeDate_
    const d = toDateAny_(rowDate);
    if (!d) continue;

    const dMs = new Date(d.getFullYear(), d.getMonth(), d.getDate()).getTime();
    if (fromMs !== null && dMs < fromMs) continue;
    if (toMs   !== null && dMs > toMs) continue;

    let salaryNum = (typeof salary === 'number') ? salary : parseNumber(String(salary || ''));
    if (!isFinite(salaryNum)) salaryNum = 0; // важно: пропуски/отмены часто идут с 0 — их НЕ убираем

    const dateStr = Utilities.formatDate(d, SPREADSHEET.getSpreadsheetTimeZone(), 'dd.MM.yyyy');

    rows.push([
      dateStr,
      String(child || '').trim(),
      String(service || '').trim(),
      salaryNum
    ]);
  }

  // сортируем по дате (как строки dd.MM.yyyy)
  const toSortKey = s => {
    const p = String(s).split('.');
    if (p.length !== 3) return 0;
    const [d, m, y] = p;
    const yy = y.length === 2 ? '20' + y : y;
    return +(yy + m.padStart(2, '0') + d.padStart(2, '0'));
  };
  rows.splice(1, rows.length - 1,
    ...rows.slice(1).sort((a, b) => toSortKey(a[0]) - toSortKey(b[0]))
  );

  return { rows };
}

