function sendReportToParent(savedCellAddress) {
  const ui = SpreadsheetApp.getUi();
  const activeSheet = SPREADSHEET.getActiveSheet();
  const childName = activeSheet.getRange(savedCellAddress).getValue();
  
  if (!childName) {
    logAndAlert('Ошибка', 'Не выбрано имя ребенка', 'Пожалуйста, выберите ячейку с именем ребенка.');
    return;
  }
  
  try {
    // 1. Формируем отчет
    const report = generateChildReport(childName);
    Logger.log ('generateChildReport сработала в репорт');
    
    if (!report || report.records.length === 0) {
      logAndAlert('Информация', 'Нет данных для отчета', 
        `Для ребенка "${childName}" не найдено данных о посещениях и оплатах.`);
      return;
    }
    
    // 2. Формируем визуальную таблицу для показа
    const visualTable = formatReportAsTable(report);
        Logger.log ('formatReportAsTable сработала в репорт');
    
    // 3. Формируем CSV для Excel
    const csvData = formatReportAsCSV(report);
            Logger.log ('formatReportAsCSV сработала в репорт/ Перед Показываем диалоговое окно с отчетом в новом стиле ' + savedCellAddress);
    
    // 4. Показываем диалоговое окно с отчетом в новом стиле
    showReportAttendance(savedCellAddress, visualTable, csvData);
    
  } catch (error) {
    logAndAlert('Ошибка', 'Не удалось сформировать отчет', error.toString());
  }
}

