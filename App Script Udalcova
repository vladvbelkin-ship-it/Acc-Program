        const dt = new Date(y.length===2?`20${y}`:y, parseInt(m)-1, d);
        if (!isNaN(dt)) dayOfWeek = ['Вс','Пн','Вт','Ср','Чт','Пт','Сб'][dt.getDay()];
      }
    } catch(e) { Logger.log(`⚠️ findClassDate ошибка: ${e.message}`); }
  }
  const t3 = Date.now(); Logger.log(`⏱ findClassDate + parse: ${t3-t2} мс`);

  // 3. Запись в A1
  try { sheet.getRange('A1').setValue(dayOfWeek || ''); } catch(e) {}
  const t4 = Date.now(); Logger.log(`⏱ setValue A1: ${t4-t3} мс`);
  Logger.log(`🏁 ИТОГО: ${Date.now()-t0} мс`);

  // 4. Запуск меню
  const addr = activeRange.getCell(1, 1).getA1Notation();
  const sName = sheet.getName();
  switch(sName) {
    case CONSTANTS.SHEET_NAMES.STAFF: showMenuStaff(addr); break;
    case CONSTANTS.SHEET_NAMES.SCHEDULE: showMenuRaspisanie(addr); break;
    case CONSTANTS.SHEET_NAMES.BALANCE: showMenuBalance(addr); break;
    default: getUI().alert('Информация', 'Действия для этого листа не настроены.', getUI().ButtonSet.OK);
  }
}

/**
 * Определяет день недели для выбранной ячейки на листе "Расписание".
 * Использует существующие функции для определения даты и преобразует ее в день недели.
 * @param {GoogleAppsScript.Spreadsheet.Range} range - Выбранная ячейка
 * @param {GoogleAppsScript.Spreadsheet.Sheet} sheet - Активный лист
 * @returns {string|null} День недели (например, "Пн", "Вт") или null если не удалось определить
 */
function getDayOfWeekForSelectedCell(range, sheet) {
  const sheetName = sheet.getName();
  
  // Эта функция актуальна только для листа "Расписание"
  if (sheetName !== CONSTANTS.SHEET_NAMES.SCHEDULE) {
    return null;
  }
  
  const cellAddress = range.getCell(1, 1).getA1Notation();
  
  try {
    // Используем существующую функцию для определения даты
    const classDate = findClassDate(cellAddress, sheet);
    
    if (!classDate) {
      Logger.log('Не удалось определить дату занятия');
      return null;
    }
    
    // Преобразуем дату в день недели
    let dateObject;
    
    if (classDate instanceof Date) {
      dateObject = classDate;
    } else if (typeof classDate === 'string' && classDate.includes('.')) {
      // Парсим строку формата "дд.мм.гггг" или "дд.мм.гг"
      const [day, month, year] = classDate.split('.');
      const fullYear = year.length === 2 ? `20${year}` : year;
      dateObject = new Date(fullYear, parseInt(month) - 1, day);
    } else {
      Logger.log(`Некорректный формат даты: ${classDate}`);
      return null;
    }
    
    if (isNaN(dateObject.getTime())) {
      Logger.log(`Не удалось преобразовать дату: ${classDate}`);
      return null;
    }
    
    // Определяем день недели
    const daysOfWeek = ['Вс', 'Пн', 'Вт', 'Ср', 'Чт', 'Пт', 'Сб'];
    const dayIndex = dateObject.getDay();
    
    return daysOfWeek[dayIndex];
    
  } catch (e) {
    Logger.log(`Ошибка при определении дня недели: ${e.message}`);
    return null;
  }
}

