/**
 * Считает количество детей в группе.
 */
function countChildrenInGroup(savedCellAddress, activeSheet) {
  const range = activeSheet.getRange(savedCellAddress);
  const row = range.getRow();
  const col = range.getColumn();
  
  const data = activeSheet.getRange(1, col - 1, activeSheet.getLastRow(), 2).getValues();

  let groupStartRow = -1;
  for (let i = row - 1; i >= 0; i--) {
    if (data[i][0]) { // Нашли педагога в левой колонке
      groupStartRow = i;
      break;
    }
  }
  if (groupStartRow === -1) return 0;
  
  let count = 0;
  for (let i = groupStartRow; i < data.length; i++) {
    if (i > groupStartRow && data[i][0]) break; // Нашли следующего педагога
    if (data[i][1]) count++; // Есть ребенок в правой колонке
  }
  return count;
}


