/**
 * Форматирует таблицу для MAX с идеальным выравниванием в HTML теге <pre>.
 * - Дата в формате ДД.ММ.ГГ
 * - Короткие названия услуг
 * - Сумма и Баланс выравниваются ВПРАВО
 * - Баланс всегда со знаком + или -
 * - Идеальное выравнивание для браузера
 * @param {string} tableText - Текст таблицы для форматирования
 * @returns {string} HTML-форматированный текст с тегом <pre>
 */
function formatTableForMAX(tableText) {
  // Убираем маркеры ``` если есть
  let cleanText = tableText.replace(/^```\s*\n?/, '').replace(/\n?```\s*$/, '');
  
  // Разбиваем на строки
  const lines = cleanText.split('\n');
  
  if (lines.length < 2) return `<pre>${tableText}</pre>`;
  
  // ===== 1. Находим строку-разделитель =====
  let separatorIndex = -1;
  for (let i = 0; i < lines.length; i++) {
    if (/^-{2,}/.test(lines[i])) {
      separatorIndex = i;
      break;
    }
  }
  
  // ===== 2. Парсим все строки в столбцы =====
  const allRows = [];
  const headerRow = [];
  
  for (let i = 0; i < lines.length; i++) {
    if (i === separatorIndex) continue;
    const line = lines[i].trim();
    if (!line) continue;
    
    // Разбиваем по 2+ пробелам или табуляции
    let parts = line.split(/\s{2,}/).filter(p => p.trim().length > 0);
    
    // Если не разбилось, пробуем по пробелам
    if (parts.length < 2) {
      parts = line.split(/\s+/).filter(p => p.trim().length > 0);
    }
    
    if (parts.length === 0) continue;
    
    // Сохраняем заголовок отдельно
    if (i === 0 || (i < separatorIndex && separatorIndex > 0)) {
      if (headerRow.length === 0) {
        headerRow.push(...parts);
      }
    }
    
    allRows.push(parts);
  }
  
  if (allRows.length === 0) return `<pre>${tableText}</pre>`;
  
  // ===== 3. Определяем количество столбцов =====
  let numCols = 0;
  for (const row of allRows) {
    if (row.length > numCols) numCols = row.length;
  }
  
  // Если столбцов меньше 2, пробуем другой подход
  if (numCols < 2) {
    const tempRows = [];
    for (const line of lines) {
      if (line.includes('---')) continue;
      const parts = line.split(/\s+/).filter(p => p.trim().length > 0);
      if (parts.length > 0) tempRows.push(parts);
    }
    if (tempRows.length > 0) {
      allRows.length = 0;
      allRows.push(...tempRows);
      numCols = 0;
      for (const row of allRows) {
        if (row.length > numCols) numCols = row.length;
      }
    }
  }
  
  if (numCols < 2) return `<pre>${tableText}</pre>`;
  
  // ===== 4. Выравниваем все строки до одинакового количества столбцов =====
  const normalizedRows = allRows.map(row => {
    const newRow = [...row];
    while (newRow.length < numCols) {
      newRow.push('');
    }
    return newRow;
  });
  
  // ===== 5. Обрабатываем каждую ячейку =====
  const processedRows = normalizedRows.map(row => {
    return row.map((cell, index) => {
      let clean = String(cell || '').trim();
      
      // === ДАТА (индекс 0) - приводим к короткому формату ===
      if (index === 0 && clean.length > 0) {
        // Пробуем преобразовать дату в формат ДД.ММ.ГГ
        const dateMatch = clean.match(/(\d{2})\.(\d{2})\.(\d{4})/);
        if (dateMatch) {
          // ДД.ММ.ГГГГ -> ДД.ММ.ГГ
          clean = dateMatch[1] + '.' + dateMatch[2] + '.' + dateMatch[3].slice(-2);
        } else {
          // Уже короткий формат или другой - оставляем как есть
          clean = clean.replace(/\.(\d{4})/g, (m, y) => '.' + y.slice(-2));
        }
        return clean;
      }
      
      // === УСЛУГА (индекс 1) - сокращаем длинные названия ===
      if (index === 1 && clean.length > 0) {
        // Убираем точки в услугах
        clean = clean.replace(/\./g, '');
        
        // Словарь сокращений
        const abbreviations = {
          'НейроМасс30': 'НМ30',
          'НейроМасс45': 'НМ45',
          'НейроМасс60': 'НМ60',
          'НейроМасс': 'НМ',
          'Сенсомоторная коррекция': 'СМК',
          'Сенсомотор коррекция': 'СМК',
          'Сенсомоторная': 'СМК',
          'СМК индивидуально': 'СМК',
          'СМК группа': 'СМК',
          'Нейропсихологическая диагностика': 'НПД',
          'Нейропсихолог диагност': 'НПД',
          'Нейро диагностика': 'НПД',
          'Перенос на след неделю': 'Перенос',
          'Перенос на след': 'Перенос',
          'Перенос на вт': 'Перенос',
          'Перенос на чт': 'Перенос',
          'Перенос на пн': 'Перенос',
          'Перенос на ср': 'Перенос',
          'Каникулы': 'Каник',
          'Отпуск': 'Отпуск',
        };
        
        // Ищем совпадение
        let found = false;
        for (const [full, short] of Object.entries(abbreviations)) {
          if (clean.includes(full)) {
            clean = short;
            found = true;
            break;
          }
        }
        
        // Если не нашли и название длинное - обрезаем
        if (!found && clean.length > 8) {
          clean = clean.substring(0, 8);
        }
        
        return clean;
      }
      
      // === ЧИСЛОВЫЕ СТОЛБЦЫ (индексы 2, 3, ...) - Сумма и Баланс ===
      if (index >= 2) {
        // Убираем точки из чисел (разделители тысяч)
        clean = clean.replace(/\./g, '');
        
        // Убираем лишние пробелы
        clean = clean.trim();
        
        // Если это "0" или "-0", приводим к "0"
        if (clean === '-0' || clean === '0' || clean === '') {
          clean = '0';
        }
        
        // Проверяем, что это число (содержит цифры, знаки + или -)
        if (/^[\d\-+]+$/.test(clean)) {
          // Преобразуем в число для работы со знаком
          let num = parseInt(clean, 10);
          
          // Если это столбец БАЛАНС (индекс 3), добавляем знак +
          if (index === 3) {
            // Баланс - всегда со знаком
            if (num > 0) {
              clean = '+' + num;
            } else if (num < 0) {
              clean = String(num); // уже есть знак -
            } else {
              clean = '0'; // ноль без знака
            }
          }
          
          // Для столбца СУММА (индекс 2) - оставляем как есть
          // (там уже есть + или - из исходных данных)
          
          return clean;
        }
        
        // Если не число, оставляем как есть
        return clean;
      }
      
      return clean;
    });
  });
  
  // ===== 6. Определяем, какие столбцы являются числовыми =====
  const numericColumns = new Set();
  
  // Проверяем первые 10 строк данных (не считая заголовка)
  const checkStart = Math.min(1, processedRows.length - 1);
  for (let i = checkStart; i < Math.min(checkStart + 10, processedRows.length); i++) {
    const row = processedRows[i];
    for (let j = 2; j < row.length; j++) {
      const cell = row[j];
      if (/^[\d\-+]+$/.test(cell) && cell !== '') {
        numericColumns.add(j);
      }
    }
  }
  
  // Если не определили числовые столбцы, считаем все столбцы с индексом >= 2 числовыми
  if (numericColumns.size === 0) {
    for (let j = 2; j < numCols; j++) {
      numericColumns.add(j);
    }
  }
  
  // ===== 7. ВЫЧИСЛЯЕМ МАКСИМАЛЬНУЮ ШИРИНУ КАЖДОГО СТОЛБЦА =====
  const colWidths = new Array(numCols).fill(0);
  
  // Сначала проходим по всем данным, чтобы найти максимальную ширину
  for (const row of processedRows) {
    for (let i = 0; i < row.length; i++) {
      const width = row[i].length;
      if (width > colWidths[i]) {
        colWidths[i] = width;
      }
    }
  }
  
  // Добавляем отступы (по 2 пробела между столбцами)
  for (let i = 0; i < colWidths.length; i++) {
    colWidths[i] += 2; // Добавляем по 2 пробела с каждой стороны
  }
  
  // Минимальные ширины для каждого столбца
  const minWidths = [10, 8, 8, 8];
  for (let i = 0; i < Math.min(minWidths.length, colWidths.length); i++) {
    if (colWidths[i] < minWidths[i]) {
      colWidths[i] = minWidths[i];
    }
  }
  
  // ===== 8. ФОРМИРУЕМ ОТФОРМАТИРОВАННЫЙ ВЫВОД =====
  const result = [];
  
  // Заголовок
  if (processedRows.length > 0) {
    const headerRowData = processedRows[0];
    const formatted = headerRowData
      .map((cell, i) => {
        // Заголовки числовых столбцов выравниваем вправо
        if (numericColumns.has(i)) {
          return cell.padStart(colWidths[i]);
        }
        // Иначе влево
        return cell.padEnd(colWidths[i]);
      })
      .join('');
    result.push(formatted);
  }
  
  // Разделитель (используем точное количество дефисов для каждой колонки)
  const separator = colWidths.map(w => '-'.repeat(w)).join('');
  result.push(separator);
  
  // Остальные строки
  const startIndex = processedRows.length > 0 ? 1 : 0;
  for (let i = startIndex; i < processedRows.length; i++) {
    const row = processedRows[i];
    if (row.every(cell => cell === '')) continue;
    
    const formatted = row
      .map((cell, j) => {
        // ЧИСЛОВЫЕ СТОЛБЦЫ - ВПРАВО
        if (numericColumns.has(j)) {
          return cell.padStart(colWidths[j]);
        }
        // ДАТА (индекс 0) - ВЛЕВО
        if (j === 0) {
          return cell.padEnd(colWidths[j]);
        }
        // УСЛУГА (индекс 1) - ВЛЕВО
        if (j === 1) {
          return cell.padEnd(colWidths[j]);
        }
        // Остальные - ВЛЕВО
        return cell.padEnd(colWidths[j]);
      })
      .join('');
    result.push(formatted);
  }
  
  // ===== 9. Возвращаем HTML с тегом <pre> =====
  // Убеждаемся, что в начале и конце нет лишних пробелов
  const finalText = result.join('\n');
  return '<pre>\n' + finalText + '\n</pre>';
}

/**
 * Отправляет расписание сотрудника на текущую неделю в Max.
 * Собирает все занятия специалиста из листа "Расписание" файла "Расписание ..." центра, заданного в константах, на текущую неделю
 * и отправляет в мессенджер Max.
 * @param {string} pedagogueName - Имя сотрудника (специалиста)
 */
function sendWeekSchedule(pedagogueName) {
  try {
    // 1. Получаем ID пользователя Max для сотрудника
    const maxUserId = findUniversal(
      CONSTANTS.SHEET_NAMES.STAFF,
      { 'Имя': pedagogueName },
      'Max'
    );
    
    if (!maxUserId) {
      getUI().alert('Ошибка', 
        `Не найден идентификатор Max для сотрудника "${pedagogueName}".\n` +
        `Проверьте поле "Max" в листе "Сотрудники".`, 
        getUI().ButtonSet.OK);
      return;
    }
    
    // 2. Получаем расписание из внешнего файла
    const weekSchedule = getPedagogueWeekSchedule(pedagogueName);
    
    if (weekSchedule.length === 0) {
      getUI().alert('Информация', 
        `На этой неделе не найдено занятий для сотрудника "${pedagogueName}".`, 
        getUI().ButtonSet.OK);
      return;
    }
    
    // 3. Формируем сообщение (используем глобальную константу CENTER)
    const message = formatWeekScheduleMessage(weekSchedule, pedagogueName);
    
    // 4. Отправляем в Max
    sendMessageToStaffMAX(pedagogueName, message);
    
    getUI().alert('Успех', 
      `Расписание отправлено сотруднику "${pedagogueName}" в Max (центр ${CENTER}).`, 
      getUI().ButtonSet.OK);
    
  } catch (error) {
    logAndAlert('Ошибка', 'Не удалось отправить расписание', error.toString());
  }
}

/**
 * Собирает расписание сотрудника из текущего листа "Расписание".
 * Сканирует все блоки "Дата" на листе и собирает занятия для указанного специалиста.
 * @param {string} pedagogueName - Имя сотрудника
 * @returns {Array<Object>} Массив объектов с информацией о занятиях
 */
function getPedagogueWeekSchedule(pedagogueName) {
  const scheduleSheet = getScheduleSheetFromExternalFile();
  if (!scheduleSheet) {
    throw new Error('Лист "Расписание" не найден.');
  }

  const lastRow = scheduleSheet.getLastRow();
  const lastCol = scheduleSheet.getLastColumn();

  if (lastRow < 2 || lastCol < 4) {
    return [];
  }

  const allData = scheduleSheet.getRange(1, 1, lastRow, lastCol).getValues();
  const weekSchedule = [];

  // Ищем все "Дата" по всему листу
  for (let r = 0; r < allData.length; r++) {
    for (let c = 0; c < allData[r].length; c++) {
      if (String(allData[r][c]).trim() !== 'Дата') continue;

      // Получаем дату справа от "Дата"
      const rawDateValue = (c + 1 < lastCol) ? allData[r][c + 1] : null;
      if (!rawDateValue) continue;

      const dateObj = normalizeDate_(rawDateValue);
      if (!dateObj) continue;

      // Определяем день недели
      const dayOfWeek = ['Вс', 'Пн', 'Вт', 'Ср', 'Чт', 'Пт', 'Сб'][dateObj.getDay()];

      // Ищем строку "Время" под блоком
      const timeHeaderRow = findTimeHeaderRow_(allData, r, c);
      if (timeHeaderRow === -1) continue;

      // Определяем колонки блока
      const timeCol = c;          // Время
      const specCol = c + 1;      // Специалист
      const childCol = c + 2;     // С кем занятие (ребенок)
      const serviceCol = c + 3;   // Услуга

      if (serviceCol >= lastCol) continue;

      // Находим границы блока (до следующей "Дата")
      const startRow = timeHeaderRow + 1;
      const endRowExclusive = findNextDateRowInColumn_(allData, c, timeHeaderRow + 1);

      // Проходим по всем строкам блока
      for (let rr = startRow; rr < endRowExclusive; rr++) {
        const currentSpecialist = safeCellStr_(allData, rr, specCol);
        
        // Проверяем, что специалист совпадает с искомым
        if (currentSpecialist !== pedagogueName) continue;
        
        const childName = safeCellStr_(allData, rr, childCol);
        if (!childName) continue;
        
        // Пропускаем служебные строки
        if (/перерыв|пауза|окно|отдых|отмена/i.test(childName)) continue;
        
        const time = safeCellStr_(allData, rr, timeCol);
        const service = safeCellStr_(allData, rr, serviceCol);
        
        // Пропускаем отмененные занятия (если в услуге указана отмена)
        if (service && ABSENCE_RE.test(normalizeTextForMatch_(service))) {
          continue;
        }
        
        // Получаем примечание к ячейке с именем ребенка
        const childCell = scheduleSheet.getRange(rr + 1, childCol + 1);
        const note = childCell.getNote() || '';
        
        weekSchedule.push({
          dayOfWeek: dayOfWeek,
          date: dateObj,
          time: time || '--:--',
          childName: childName,
          service: service || 'не указана',
          note: note
        });
      }
    }
  }

  // Сортируем по дате (от понедельника к субботе)
  weekSchedule.sort((a, b) => a.date - b.date);
  
  return weekSchedule;
}

/**
 * Форматирует расписание сотрудника в читаемое сообщение для Max.
 * @param {Array<Object>} schedule - Массив занятий
 * @param {string} pedagogueName - Имя сотрудника
 * @returns {string} Отформатированное сообщение
 */
function formatWeekScheduleMessage(schedule, pedagogueName) {
  if (schedule.length === 0) {
    return `Здравствуйте, ${pedagogueName}.\n\nНа этой неделе занятий нет.`;
  }

  let message = `Здравствуйте, ${pedagogueName}.\n\n`;
  message += `Ваше расписание на эту неделю (центр ${CENTER}):\n\n`;
  
  // Группируем по дням недели в правильном порядке
  const daysOrder = ['Пн', 'Вт', 'Ср', 'Чт', 'Пт', 'Сб', 'Вс'];
  const grouped = {};
  
  schedule.forEach(item => {
    if (!grouped[item.dayOfWeek]) {
      grouped[item.dayOfWeek] = [];
    }
    grouped[item.dayOfWeek].push(item);
  });
  
  // Выводим по дням недели
  daysOrder.forEach(day => {
    if (!grouped[day]) return;
    
    const items = grouped[day];
    items.forEach((item) => {
      const timeStr = item.time.trim();
      message += `${day}  ${timeStr}  ${item.childName}  ${item.service}\n`;
      
      if (item.note) {
        const noteLines = item.note.split('\n').filter(line => line.trim() !== '');
        
        let phone = '';
        let otherNotes = [];
        
        noteLines.forEach(line => {
          const trimmedLine = line.trim();
          const phoneMatch = trimmedLine.match(/([\+\d][\d\s\-\(\)]{5,})/);
          if (phoneMatch && !phone) {
            phone = phoneMatch[0].trim();
          } else if (trimmedLine) {
            otherNotes.push(trimmedLine);
          }
        });
        
        if (phone) {
          // Добавляем + если его нет
          const formattedPhone = phone.startsWith('+') ? phone : '+' + phone;
          message += `Тел.: ${formattedPhone}\n`;
        }
        
        if (otherNotes.length > 0) {
          const combinedNotes = otherNotes.join(' ');
          const cleanNote = combinedNotes.replace(/\s+/g, ' ').trim();
          if (cleanNote) {
            message += `[${cleanNote}]\n`;
          }
        }
      }
      
      message += `------------------------\n`;
    });
  });
  
  const totalLessons = schedule.length;
  message += `\n✅ Всего занятий: ${totalLessons}`;
  
  return message;
}

/**
 * Отправляет сообщение сотруднику в MAX через API
 * @param {string} pedagogueName - Имя сотрудника (для получения user_Id из листа "Сотрудники")
 * @param {string} message - Текст сообщения (до 4000 символов)
 * @returns {Object} Ответ от API
 * @throws {Error} Если не удалось отправить сообщение
 */
function sendMessageToStaffMAX(pedagogueName, message) {
  // Проверка обязательных параметров
  if (!pedagogueName) {
    throw new Error('❌ Не указано имя сотрудника');
  }
  
  if (!message || typeof message !== 'string') {
    throw new Error('❌ Сообщение не может быть пустым');
  }
  
  if (message.length > 4000) {
    throw new Error('❌ Сообщение превышает лимит в 4000 символов');
  }
  
  // Получаем ID пользователя из листа "Сотрудники"
  const userId = findUniversal(
    CONSTANTS.SHEET_NAMES.STAFF,
    { 'Имя': pedagogueName },
    'Max'
  );
  
  if (!userId) {
    throw new Error(`❌ Не найден user_Id для сотрудника: ${pedagogueName}`);
  }
  
  // Формируем запрос
  const url = `https://platform-api.max.ru/messages?user_id=${encodeURIComponent(userId)}`;
  
  const payload = {
    text: message,
    format: "html"
  };
  
  const options = {
    method: 'post',
    headers: {
      'Authorization': ACCESS_MAX_TOKEN,
      'Content-Type': 'application/json'
    },
    payload: JSON.stringify(payload),
    muteHttpExceptions: true
  };
  
  try {
    const response = UrlFetchApp.fetch(url, options);
    const statusCode = response.getResponseCode();
    const responseText = response.getContentText();
    const result = JSON.parse(responseText);
    
    if (statusCode !== 200 && statusCode !== 201) {
      Logger.log(`⚠️ API вернул код ${statusCode}: ${responseText}`);
      throw new Error(`Ошибка API: ${statusCode} - ${result.error || result.message || responseText}`);
    }
    
    Logger.log(`✅ Сообщение отправлено сотруднику ${userId} (${pedagogueName})`);
    return result;
    
  } catch (error) {
    Logger.log(`❌ Ошибка при отправке сообщения: ${error.toString()}`);
    throw new Error(`Не удалось отправить сообщение для ${pedagogueName}: ${error.message}`);
  }
}

