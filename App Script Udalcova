/**
 * Обрабатывает действия, выбранные для ребенка.
 * @param {string} action - Номер выбранного действия.
 * @param {string} savedCellAddress - Адрес ячейки с именем ребенка.
 * @param {GoogleAppsScript.Spreadsheet.Sheet} activeSheet - Активный лист.
 */
function handleChildAction(action, savedCellAddress, activeSheet) {
  let personName, parentData, currentDate, classTime, message, data, formattedDate, onlyPersonName;

  switch (action) {
    case '1': // Сообщение родителям (бывший кейс '3')
      personName = activeSheet.getRange(savedCellAddress).getValue();
      onlyPersonName = personName.split(' ')[0];
      parentData = findParentNamesByKidName(savedCellAddress, activeSheet);
      if (parentData.length === 0) {
        logAndAlert('Ошибка', 'Родитель не найден', `Данные родителя для ребенка "${personName}" не найдены в листе "Клиенты".`);
        return;
      }
      
      const sessionTypeValue = sessionType(savedCellAddress, activeSheet);
      currentDate = Utilities.formatDate(findClassDate(savedCellAddress, activeSheet), SPREADSHEET.getSpreadsheetTimeZone(), "dd.MM.yy");
      classTime = findClassTime(savedCellAddress, activeSheet);
      
      if (sessionTypeValue !== 'НПД') {
        // Новое подменю для обычных занятий
        message = `Выберите действие:\n1 - Напомнить о текущем занятии\n2 - Напомнить всем родителям о занятиях (за день)\n3 - Уведомить о записи на занятия\n4 - Сообщить о первом занятии\n5 - Сообщить родителю "занятия не будет"\n6 - Ответить родителю "Заморозка" (болезнь)\n7 - Уведомить всех родителей, что занятий не будет`;
        const response = getUI().prompt(`${personName}`, message, getUI().ButtonSet.OK_CANCEL);

        if (response.getSelectedButton() === getUI().Button.OK) {
          const subAction = response.getResponseText().trim();
          switch (subAction) {
            case '1': // Напомнить о текущем занятии (бывший кейс '3' в подменю)
              message = `Хочу напомнить, что у вас ${currentDate} занятие в ${classTime}.\nСообщите, пожалуйста, придете ли Вы?`;
              break;
            case '2': // Напомнить всем родителям о занятиях (за день)
              data = getChildrenByDate(savedCellAddress, activeSheet);
              sendWhatsAppRemindAttendanceDate(data);
              return; // Выходим, т.к. эта функция уже отправляет сообщения
            case '3': // Уведомить о записи на занятия
              // Получаем расписание ребенка
              const schedule = findChildScheduleForWeek(savedCellAddress);
  
              if (schedule.length === 0) {
                message = "Ваш ребенок записан на занятия. Расписание уточняется.";
              } else {
                // Формируем сообщение
                message = "\n\nВаш ребенок записан на занятия по:\n\n";
                
                // Обрабатываем каждое занятие
                schedule.forEach(item => {
                  // Получаем полное название услуги из листа "Сотрудники"
                  const fullServiceName = findUniversal(
                    CONSTANTS.SHEET_NAMES.STAFF,
                    { 'Услуга сокращ.': item.service },
                    'Услуга'
                  );
                  
                  // Используем полное название если найдено, иначе сокращенное
                  const serviceDisplay = fullServiceName || item.service;
                  
                  // Форматируем строку
                  message += `${item.dayOfWeek} в ${item.time}     Специалист: ${item.specialist}.     Услуга: ${serviceDisplay}\n`;
                });
              }
              break;
            case '4': // Сообщить о первом занятии (бывший кейс '2' в подменю)
              if (parentData.length === 0) return;
              message = `\n${currentDate} в ${classTime} ${onlyPersonName} посетит своё первое занятие.\nПринесите, пожалуйста, спортивные штаны и футболку с длинным рукавом. Колени и локти должны быть прикрыты. Сменная обувь не нужна, детки занимаются в носочках.\nВы можете присутствовать на первом занятии, познакомиться с педагогом и программой, задать вопросы.\nВ следующие занятия ребенок будет занимается с педагогом самостоятельно.`;
              sendMessageNew(parentData, message);
              return;
            case '5': // Сообщить родителю "занятия не будет" (бывший кейс '5' в основном меню)
              if (parentData.length === 0) return;
              message = `\nК сожалению, наш сотрудник заболел.\n${currentDate} в ${classTime} занятия не будет.\nПриносим свои извинения!`;
              break;
            case '6': // Ответить родителю "Заморозка" (болезнь) (бывший кейс '6' в основном меню)
              if (parentData.length === 0) return;
              message = `спасибо за информацию.\nЗанятие ${currentDate} ставим на паузу.\nПусть ${personName.split(' ')[0]} скорее поправляется!`;
              break;
            case '7': // Уведомить всех родителей, что занятий не будет (бывший кейс '8' в основном меню)
              data = getChildrenByDate(savedCellAddress, activeSheet);
              message = `\nCообщаем, что, к сожалению, ${currentDate} занятия не будет.\nПриносим свои извинения!`;
              sendShortMessageForRange(data, message);
              return; // Выходим, т.к. эта функция уже отправляет сообщения
            default:
              logAndAlert('Ошибка: Неверный выбор. Введено: ' + subAction, 'Ошибка', 'Проверьте правильность выбора.');
              return;
          }
        } else {
          Logger.log('Пользователь отменил выбор');
          return;
        }
      } else {
        // Старое подменю для НПД (без изменений)
        message = `Выберите действие:\n1 - Уведомить о записи на НПД\n2 - Напомнить о предстоящей НПД`;
        const response = getUI().prompt(`${personName}`, message, getUI().ButtonSet.OK_CANCEL);

        if (response.getSelectedButton() === getUI().Button.OK) {
          const subAction = response.getResponseText().trim();
          switch (subAction) {
            case '1':
              message = `\n\nВаш ребенок ${personName} записан на нейропсихологическую диагностику на ${currentDate} в ${classTime}.\n\nНа диагностику желательно принести:\n- медицинскую карту (если она на руках);\n- заключения других специалистов (невролога/психиатра, логопеда/дефектолога);\n- результаты обследований (ЭЭГ, УЗДГ сосудов шеи и головы, МРТ головного мозга);\n- тетради по русскому языку и математике (если школьник).\n\nДлительность диагностики около 2-х часов.\nСтоимость - 6500 р.\nНаш адрес: ${CONSTANTS.ADDRESS}.\n\nНакануне диагностики мы свяжемся с Вами и напомним о визите.`;
              sendMessageNew(parentData, message);
              return;
            case '2':
              message = `\n\nХотим напомнить, что у вас ${currentDate} в ${classTime} запланирована нейропсихологическая диагностика.\n\nТакже хотим напомнить, что на диагностику желательно принести:\n- медицинскую карту (если она на руках);\n- заключения других специалистов (невролога/психиатра, логопеда/дефектолога);\n- результаты обследований (ЭЭГ, УЗДГ сосудов шеи и головы, МРТ головного мозга);\n- тетради по русскому языку и математике (если школьник).\n\nДлительность диагностики около 2-х часов.\nСтоимость - 6500 р.\nНаш адрес: ${CONSTANTS.ADDRESS}.\n\nСообщите, пожалуйста, придете ли Вы?`;
              sendMessageNew(parentData, message);
              return;
            default:
              logAndAlert('Ошибка: Неверный выбор. Введено: ' + subAction, 'Ошибка', 'Проверьте правильность выбора.');
              return;
          }
        } else {
          Logger.log('Пользователь отменил выбор');
          return;
        }
      }
      
      // Отправляем сообщение только если оно было сформировано 8888888888888
      // sendShortMessage(parentData, message); //для коротких сообщений. Длинные сообщения выводятся sendMessageNew(parentData, message) сразу за формированием сообщения
      sendMessageNew(parentData, message);
      break;

    case '2': // Добавить посещение занятия (бывший кейс '1')
      if (!isChildInDatabase(savedCellAddress, activeSheet)) {
        const response = getUI().alert('Новый ребенок?', `Похоже, "${activeSheet.getRange(savedCellAddress).getValue()}" - новый ребенок.\nДобавить его в базу "Клиенты"?`, getUI().ButtonSet.YES_NO);
        if (response === getUI().Button.YES) {
          addChildToDatabase(savedCellAddress, activeSheet);
          getUI().alert('Готово', 'Ребенок добавлен. Не забудьте указать данные родителя, чтобы отправлять уведомления.', getUI().ButtonSet.OK);
        }
      }
      addAttendance(savedCellAddress, 'Вывести сообщение', null, activeSheet);
      break;

    case '3': // Добавить посещения ВСЕМ ДЕТЯМ ЗА ДЕНЬ (бывший кейс '7')
      processDateAttendance(savedCellAddress, activeSheet);
      break;

    case '4': // Добавить посещения ВСЕМ ДЕТЯМ ЗА НЕДЕЛЮ (бывший кейс '9')
      processAllDaysInSchedule();
      break;

    case '5': // Добавить оплату (бывший кейс '2')
      addPayment(savedCellAddress, activeSheet);
      break;

    case '6': // Добавить событие в Google Календарь
      addGoogleCalendarEvent(savedCellAddress, activeSheet);
      break;

    default:
      logAndAlert('Ошибка', 'Неверный выбор', 'Выбрано некорректное действие.');
      break;
  }
}

/**
 * Добавляет событие в Google Календарь для специалиста Белкина И.
 * @param {string} savedCellAddress - Адрес ячейки с именем ребенка.
 * @param {GoogleAppsScript.Spreadsheet.Sheet} activeSheet - Активный лист.
 */

function addGoogleCalendarEvent(savedCellAddress, activeSheet) {
  const childName = activeSheet.getRange(savedCellAddress).getValue();
  if (!childName) {
    getUI().alert('Ошибка', 'Не удалось определить имя ребенка.', getUI().ButtonSet.OK);
    return;
  }

  // Получаем специалиста из ячейки слева
  const range = activeSheet.getRange(savedCellAddress);
  const specialistCell = range.offset(0, -1); // ячейка слева (Специалист)
  const specialistName = specialistCell.getValue();
  
  // Проверяем, что специалист - Белкина И (содержит "Белкин")
  if (!specialistName || !String(specialistName).toLowerCase().includes('белкин')) {
    getUI().alert('Действие недоступно', 
      `Функция добавления события в календарь доступна только для специалиста Белкина И.\nТекущий специалист: ${specialistName || 'не указан'}`, 
      getUI().ButtonSet.OK);
    return;
  }

  // Получаем дату и время занятия
  const classDateRaw = findClassDate(savedCellAddress, activeSheet);
  const dateObj = toDateAny_(classDateRaw);
  if (!dateObj) {
    getUI().alert('Ошибка', 'Не удалось определить дату занятия.', getUI().ButtonSet.OK);
    return;
  }
  const classTime = findClassTime(savedCellAddress, activeSheet);
  if (!classTime) {
    getUI().alert('Ошибка', 'Не удалось определить время занятия.', getUI().ButtonSet.OK);
    return;
  }

  // Парсим время (ожидается формат "ЧЧ:ММ" или "Ч:ММ")
  let hours = 0, minutes = 0;
  const timeMatch = String(classTime).match(/(\d{1,2}):(\d{2})/);
  if (timeMatch) {
    hours = parseInt(timeMatch[1], 10);
    minutes = parseInt(timeMatch[2], 10);
  } else {
    getUI().alert('Ошибка', `Не удалось распознать время "${classTime}". Используйте формат "ЧЧ:ММ".`, getUI().ButtonSet.OK);
    return;
  }

  // Формируем объект даты и времени начала
  const startDateTime = new Date(dateObj);
  startDateTime.setHours(hours, minutes, 0, 0);

  // ПАРСИМ ВРЕМЯ ОКОНЧАНИЯ из той же ячейки "Время"
  // Предполагается формат "10:00-12:00" или "10:00 – 12:00" или "10:00 - 12:00"
  let endHours = hours, endMinutes = minutes;
  const timeRangeMatch = String(classTime).match(/(\d{1,2}):(\d{2})\s*[-–—]\s*(\d{1,2}):(\d{2})/);
  if (timeRangeMatch) {
    endHours = parseInt(timeRangeMatch[3], 10);
    endMinutes = parseInt(timeRangeMatch[4], 10);
  } else {
    // Если формат не распознан, по умолчанию +1 час
    endHours = hours + 1;
    endMinutes = minutes;
  }

  const endDateTime = new Date(dateObj);
  endDateTime.setHours(endHours, endMinutes, 0, 0);

  // Если время окончания раньше времени начала (переход через полночь), добавляем день
  if (endDateTime < startDateTime) {
    endDateTime.setDate(endDateTime.getDate() + 1);
  }

  // Получаем услугу
  const service = sessionType(savedCellAddress, activeSheet) || 'не указана';
  
  // Получаем примечание к ячейке ребенка
  const cellNote = activeSheet.getRange(savedCellAddress).getNote() || '';
  
  // Извлекаем телефон из примечания
  let phone = '';
  const phoneMatch = cellNote.match(/[\+\d][\d\s\-\(\)]{5,}/);
  if (phoneMatch) phone = phoneMatch[0].trim();
  
  // Описание мероприятия - всё примечание целиком
  const descriptionNote = cellNote;
  
  // ФОРМИРУЕМ НАЗВАНИЕ СОБЫТИЯ в зависимости от наличия телефона
  let eventTitle;
  if (phone) {
    // Если телефон есть - включаем его в название
    eventTitle = `Перемена, Услуга: ${service}, Клиент: ${childName}, Телефон: ${phone}`;
  } else {
    // Если телефона нет - название без телефона
    eventTitle = `Перемена, Услуга: ${service}, Клиент: ${childName}`;
  }
  
  // ОПРЕДЕЛЯЕМ МЕСТО (location) ИЗ НАЗВАНИЯ КНИГИ (таблицы)
  const spreadsheetName = SPREADSHEET.getName();
  let location = '';
  if (spreadsheetName.toLowerCase().includes('вольная')) {
    location = 'Вольная';
  } else if (spreadsheetName.toLowerCase().includes('удальцова')) {
    location = 'Удальцова';
  } else {
    location = 'Не указано';
  }

  // ID календаря для Белкиной И.
  const calendarId = 'f3872498480e8b40986de70e30921aad916e402d766d97ba5b00f81aba31dbb2@group.calendar.google.com';
  
  try {
    const calendar = CalendarApp.getCalendarById(calendarId);
    if (!calendar) {
      getUI().alert('Ошибка', `Календарь с ID "${calendarId}" не найден. Проверьте доступность.`, getUI().ButtonSet.OK);
      return;
    }
    
    const event = calendar.createEvent(
      eventTitle,
      startDateTime,
      endDateTime,
      {
        description: descriptionNote,
        location: location
      }
    );
    
  if (event) {
    // Добавляем поп-ап напоминание (всплывающее) за 1 день (24 часа * 60 минут = 1440 минут)
    event.addPopupReminder(24 * 60); // 1440 минут = 24 часа
      getUI().alert('Успех', `Событие добавлено в календарь:\nДата: ${Utilities.formatDate(dateObj, Session.getScriptTimeZone(), 'dd.MM.yyyy')}\nВремя: ${classTime}\nМесто: ${location}\nКлиент: ${childName}\nУслуга: ${service}`, getUI().ButtonSet.OK);
    } else {
      getUI().alert('Ошибка', 'Не удалось создать событие.', getUI().ButtonSet.OK);
    }
  } catch (error) {
    getUI().alert('Ошибка', `При создании события произошла ошибка:\n${error.toString()}`, getUI().ButtonSet.OK);
    Logger.log(`Calendar error: ${error.toString()}`);
  }
}

/**
* Обрабатывает ВСЕ дни (все блоки "Дата ... / Время ...") на листе "Расписание"
* и добавляет посещения всем детям за неделю.
*
* ОПТИМИЗАЦИЯ: все строки собираются в памяти и записываются ОДНИМ вызовом setValues.
*/
function processAllDaysInSchedule() {
  const scheduleSheet = SPREADSHEET.getSheetByName(CONSTANTS.SHEET_NAMES.SCHEDULE);
  if (!scheduleSheet) {
    getUI().alert('Ошибка', 'Лист "Расписание" не найден.', getUI().ButtonSet.OK);
    return;
  }
  try {
    checkSheetExists(CONSTANTS.SHEET_NAMES.ATTENDANCE);
  } catch (e) {
    return;
  }

  const lastRow = scheduleSheet.getLastRow();
  const lastCol = scheduleSheet.getLastColumn();
  if (lastRow < 2 || lastCol < 4) {
    getUI().alert('Информация', 'Лист "Расписание" пустой или структура слишком маленькая.', getUI().ButtonSet.OK);
    return;
  }

  const allData = scheduleSheet.getRange(1, 1, lastRow, lastCol).getValues();
  const warnings = [];
  const missingCosts = [];
  const added = [];
  let blocksFound = 0;

  // Прогреваем кэш базы детей ОДИН раз на всю неделю
  const childrenSet = getChildrenNameSet_();

  // === СБОРЩИК: все строки для пакетной записи ===
  const allDataToInsert = [];
  // Ячейки для пакетной подсветки (чтобы не дёргать setBackground на каждой)
  const cellsToHighlight = [];

  // Ищем все "Дата" по всему листу
  for (let r = 0; r < allData.length; r++) {
    for (let c = 0; c < allData[r].length; c++) {
      if (String(allData[r][c]).trim() !== 'Дата') continue;

      const rawDateValue = (c + 1 < lastCol) ? allData[r][c + 1] : null;
      const rawDateStr = String(rawDateValue ?? '').trim();
      if (!rawDateStr) continue;

      const dateObj = normalizeDate_(rawDateValue);
      if (!dateObj) {
        warnings.push({
          dateStr: '(дата не распознана)',
          child: '(блок)',
          reason: `Нераспознанная дата справа от "Дата": "${rawDateStr}"`
        });
        continue;
      }

      const dateStr = Utilities.formatDate(dateObj, SPREADSHEET.getSpreadsheetTimeZone(), 'dd.MM.yyyy');

      const timeHeaderRow = findTimeHeaderRow_(allData, r, c);
      if (timeHeaderRow === -1) {
        warnings.push({ dateStr, child: '(блок)', reason: 'Не найдена строка "Время" под блоком "Дата"' });
        continue;
      }

      const childCol = c + 2;
      const serviceCol = c + 3;
      if (serviceCol >= lastCol) {
        warnings.push({
          dateStr, child: '(блок)',
          reason: 'Недостаточно колонок для блока (ожидались 4 колонки: Время, Специалист, С кем занятие, Услуга)'
        });
        continue;
      }

      blocksFound++;

      const startRow = timeHeaderRow + 1;
      const endRowExclusive = findNextDateRowInColumn_(allData, c, timeHeaderRow + 1);

      for (let rr = startRow; rr < endRowExclusive; rr++) {
        const childName = safeCellStr_(allData, rr, childCol);
        if (!childName) continue;
        if (/перерыв|пауза|отмена/i.test(childName)) continue;

        const childCellA1 = scheduleSheet.getRange(rr + 1, childCol + 1).getA1Notation();

        try {
          if (!childrenSet.has(String(childName).trim())) {
            warnings.push({
              dateStr, child: childName,
              reason: 'Ребенок не найден в базе "Клиенты" (в недельном режиме автодобавление отключено)'
            });
            continue;
          }

          // ⚡ Режим 'collect' — данные собираются, но НЕ пишутся в лист
          const result = addAttendance(childCellA1, null, dateObj, scheduleSheet, 'collect');

          if (result && result.success) {
            if (Array.isArray(result.dataToInsert) && result.dataToInsert.length > 0) {
              allDataToInsert.push(...result.dataToInsert);
              cellsToHighlight.push(childCellA1);
            }
            added.push({ dateStr, child: childName });
            if (result.costWasMissing) {
              missingCosts.push({
                dateStr,
                child: result.childName || childName,
                service: result.service || '(услуга не определена)'
              });
            }
          } else {
            warnings.push({
              dateStr, child: childName,
              reason: (result && result.reason) ? result.reason
                : 'Не удалось добавить посещение (проверьте структуру, педагога, услугу, время/стоимость)'
            });
          }
        } catch (e) {
          warnings.push({
            dateStr, child: childName,
            reason: `Исключение при добавлении: ${e && e.message ? e.message : String(e)}`
          });
        }
      }
    }
  }

  // === ОДИН вызов setValues для всех собранных строк ===
  if (allDataToInsert.length > 0) {
    try {
      const sheet = checkSheetExists(CONSTANTS.SHEET_NAMES.ATTENDANCE);
      const targetRow = sheet.getLastRow() + 1;
      const numCols = allDataToInsert[0].length;
      sheet.getRange(targetRow, 1, allDataToInsert.length, numCols).setValues(allDataToInsert);
      Logger.log(`Пакетно записано ${allDataToInsert.length} строк посещений.`);
    } catch (e) {
      warnings.push({
        dateStr: '(запись)', child: '(все)',
        reason: `Ошибка пакетной записи: ${e && e.message ? e.message : String(e)}`
      });
    }
  }

  // === Пакетная подсветка ячеек ===
  if (cellsToHighlight.length > 0) {
    try {
      const rangeList = scheduleSheet.getRangeList(cellsToHighlight);
      rangeList.setBackground(CONSTANTS.COLOR_ATTENDED_KID);
    } catch (e) {
      Logger.log(`Не удалось подсветить ячейки: ${e.message}`);
    }
  }

  // === Итоговое окно ===
  const addedCount = added.length;
  const warnCount = warnings.length;
  const missingCostCount = missingCosts.length;
  let message = '';
  message += 'Готово.\n';
  message += `Найдено блоков (Дата/Время): ${blocksFound}\n`;
  message += `Добавлено посещений: ${addedCount}\n`;
  if (allDataToInsert.length > 0) {
    message += `(строк в листе "Посещения": ${allDataToInsert.length})\n`;
  }
  if (missingCostCount > 0) {
    message += `\nВНИМАНИЕ: добавлено с 0 руб. (не найдена стоимость): ${missingCostCount}\n`;
    missingCosts.slice(0, 25).forEach(x => {
      message += `- ${x.dateStr}: ${x.child} (${x.service})\n`;
    });
    if (missingCostCount > 25) message += `... и еще ${missingCostCount - 25}\n`;
  }
  if (warnCount > 0) {
    message += `\nПредупреждения (не добавлено / неполные данные): ${warnCount}\n`;
    warnings.slice(0, 25).forEach(w => {
      message += `- ${w.dateStr}: ${w.child} — ${w.reason}\n`;
    });
    if (warnCount > 25) message += `... и еще ${warnCount - 25}\n`;
  }
  getUI().alert('Посещения за неделю', message, getUI().ButtonSet.OK);
}

/** Ищет строку "Время" ниже найденной ячейки "Дата" в том же столбце. */
function findTimeHeaderRow_(allData, dateRow, dateCol) {
  const maxLookAhead = 8;

  for (let rr = dateRow + 1; rr < allData.length && rr <= dateRow + maxLookAhead; rr++) {
    if (String(allData[rr][dateCol]).trim() === 'Время') return rr;
  }

  // fallback до следующей "Дата"
  for (let rr = dateRow + 1; rr < allData.length; rr++) {
    const v = String(allData[rr][dateCol]).trim();
    if (v === 'Время') return rr;
    if (v === 'Дата') break;
  }

  return -1;
}

/** Ищет следующую строку "Дата" в заданном столбце, начиная с fromRow (0-based). */
function findNextDateRowInColumn_(allData, col, fromRow) {
  for (let rr = fromRow; rr < allData.length; rr++) {
    if (String(allData[rr][col]).trim() === 'Дата') return rr;
  }
  return allData.length;
}

/** Безопасно берет строку из массива как trimmed string. */
function safeCellStr_(allData, r, c) {
  if (r < 0 || c < 0) return '';
  if (!allData[r] || typeof allData[r][c] === 'undefined') return '';
  return String(allData[r][c] || '').trim();
}

/**
 * Нормализует дату из ячейки:
 * - Date -> Date
 * - "dd.MM.yyyy" / "dd.MM.yy" -> Date
 * - иначе -> null
 */
function normalizeDate_(value) {
  return toDateAny_(value);
}



/**
 * Обрабатывает действия, выбранные для педагога (расширенная версия).
 * @param {string} action - Номер выбранного действия.
 * @param {string} savedCellAddress - Адрес ячейки с именем педагога.
 * @param {GoogleAppsScript.Spreadsheet.Sheet} activeSheet - Активный лист.
 */
function handlePedagogueAction(action, savedCellAddress, activeSheet) {
  const range = activeSheet.getRange(savedCellAddress);
  const rightCellAddress = range.offset(0, 1).getA1Notation(); // Ячейка с ребенком

  // было: const currentDate = findClassDate(...)
  const rawDate = findClassDate(rightCellAddress, activeSheet);
  const dateObj = toDateAny_(rawDate);
  const currentDateStr = dateObj
    ? Utilities.formatDate(dateObj, SPREADSHEET.getSpreadsheetTimeZone(), 'dd.MM.yyyy')
    : String(rawDate ?? '').trim(); // fallback, если дата не распознана

  switch (action) {
    case '1': {
      const classTime = findClassTime(rightCellAddress, activeSheet);
      const personName = activeSheet.getRange(rightCellAddress).getValue();
      const pedagoguesInfo = findPedagogue(rightCellAddress, activeSheet);
      if (pedagoguesInfo.length === 0) {
        logAndAlert('Ошибка', 'Педагог не найден', 'Не удалось найти данные педагога.');
        return;
      }
      const message = `Хочу уведомить, что занятия ${currentDateStr} в ${classTime} с ${personName} не будет.`;
      sendShortMessage(pedagoguesInfo, message);
      break;
    }

    case '2': {
      const pedagogues = getPedagoguesByDate(savedCellAddress, activeSheet);
      const messageAll = `Хочу уведомить, что занятий ${currentDateStr} не будет.`;
      sendShortMessage(pedagogues, messageAll);
      break;
    }

    case '3': {
      // НОВАЯ ОПЦИЯ: Отправить в Max расписание сотрудника
      const pedagogueName = activeSheet.getRange(savedCellAddress).getValue();
      if (!pedagogueName) {
        logAndAlert('Ошибка', 'Имя сотрудника не найдено', 'Не удалось определить имя сотрудника.');
        return;
      }
      sendWeekSchedule(pedagogueName);
      break;
    }

    default:
      logAndAlert('Ошибка', 'Неверный выбор', 'Выбрано некорректное действие.');
      break;
  }
}


