// --- Вспомогательные утилиты ---
function parseNumber(str) { 
  if (!str) return NaN; 
  const clean = String(str).replace(/[^0-9.,-]/g, '').replace(',', '.'); 
  return parseFloat(clean); 
}

function parseDMY_(v) {
  if (v instanceof Date && !isNaN(v)) return v;

  const s = String(v ?? '').trim();
  if (!s) return null;

  // dd.MM.yy / dd.MM.yyyy
  const m = s.match(/^(\d{1,2})\.(\d{1,2})\.(\d{2}|\d{4})$/);
  if (m) {
    const day = Number(m[1]);
    const month = Number(m[2]);
    let year = Number(m[3]);
    if (m[3].length === 2) year = 2000 + year; // <- КЛЮЧЕВОЕ
    const d = new Date(year, month - 1, day);
    return isNaN(d) ? null : d;
  }

  // yyyy-mm-dd (из input type="date")
  const m2 = s.match(/^(\d{4})-(\d{2})-(\d{2})$/);
  if (m2) {
    const d = new Date(Number(m2[1]), Number(m2[2]) - 1, Number(m2[3]));
    return isNaN(d) ? null : d;
  }

  return null;
}

function toDateAny_(v) {
  // приоритет DMY/ISO, а не new Date(string)
  const d = parseDMY_(v);
  if (d) return d;

  if (v instanceof Date && !isNaN(v)) return v;

  // если это число (serial date) — редко, но бывает
  if (typeof v === 'number' && isFinite(v)) {
    // Google Sheets date serial -> Date (если вдруг прилетит)
    // 25569 = дни между 1899-12-30 и 1970-01-01
    const ms = (v - 25569) * 86400 * 1000;
    const dt = new Date(ms);
    if (!isNaN(dt)) return dt;
  }

  return null;
}

function startOfDayMs_(d) {
  return new Date(d.getFullYear(), d.getMonth(), d.getDate()).getTime();
}

