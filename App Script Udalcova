/** Отправляет напоминание специалистам еженедельно в группу Max "Перемена Москва". Через триггер App Script ****************/
function sendWeeklyReminderMax() {
  // Получаем текущую дату
  const now = new Date();
  
  // Вычисляем дату понедельника ПРОШЛОЙ недели
  const currentDay = now.getDay(); // 0 - воскресенье, 1 - понедельник, ...
  const daysToMonday = (currentDay === 0) ? 6 : currentDay - 1; // сколько дней до понедельника этой недели
  const lastMonday = new Date(now);
  lastMonday.setDate(now.getDate() - daysToMonday - 7); // отнимаем до понедельника этой недели + еще 7 дней
  
  // Вычисляем дату субботы ПРОШЛОЙ недели (понедельник + 5 дней)
  const lastSaturday = new Date(lastMonday);
  lastSaturday.setDate(lastMonday.getDate() + 5);
  
  // Форматируем даты в формате ДД.ММ.ГГ
  const formatDate = (date) => {
    const day = String(date.getDate()).padStart(2, '0');
    const month = String(date.getMonth() + 1).padStart(2, '0');
    const year = String(date.getFullYear()).slice(-2); // берем последние 2 цифры года
    return `${day}.${month}.${year}`;
  };
  
  const date1 = formatDate(lastMonday);
  const date2 = formatDate(lastSaturday);
  
  // Формируем сообщение
  const message = `Здравствуйте, Коллеги.\nПроверьте, пожалуйста, расписание с ${date1} по ${date2}\n\nКак проверите, сообщите в <a href="${MY_MAX_PROFILE}">личку</a>`;
  
  // Отправка сообщения в чат
  sendMessageToMAXGroup(message, ACCESS_MAX_TOKEN, MAX_CHAT_ID, {});
}

/** Отправляет сообщение в группу MAX через API
 @param {string} message - Текст сообщения (обязательно, не более 4000 символов)
 @param {string} ACCESS_TOKEN - Токен авторизации API
 @param {number|string} chatId - ID группы (отрицательное число)
 @param {Object} extraOptions - Дополнительные параметры для payload (опционально)
 @returns {Object} Результат ответа API
 @throws {Error} Если сообщение пустое, превышает лимит или возникла ошибка API
 */
function sendMessageToMAXGroup(message, max_token, max_chatId,  extraOptions = {}) { 
  // Проверка обязательных параметров
  if (!message || typeof message !== 'string') {
    throw new Error('❌ Сообщение не может быть пустым');
  }
  
  if (message.length > 4000) {
    throw new Error('❌ Сообщение превышает лимит в 4000 символов');
  }
  
  // ID группы (отрицательное число)
  
  // ✅ Формируем запрос с параметром chat_id
  const url = `https://platform-api.max.ru/messages?chat_id=${encodeURIComponent(max_chatId)}`;
  
  const payload = {
    text: message,
    format: "html",
    ...extraOptions
  };
  
  const options = {
    method: 'post',
    headers: {
      'Authorization': max_token,
      'Content-Type': 'application/json'
    },
    payload: JSON.stringify(payload),
    muteHttpExceptions: true
  };
  
  try {
    const response = UrlFetchApp.fetch(url, options);
    const statusCode = response.getResponseCode();
    const responseText = response.getContentText();
    const result = JSON.parse(responseText);
    
    if (statusCode !== 200 && statusCode !== 201) {
      Logger.log(`⚠️ API вернул код ${statusCode}: ${responseText}`);
      throw new Error(`Ошибка API: ${statusCode} - ${result.error || result.message || responseText}`);
    }
    
    Logger.log(`✅ Сообщение отправлено в группу ${max_chatId}`);
    return result;
    
  } catch (error) {
    Logger.log(`❌ Ошибка при отправке сообщения: ${error.toString()}`);
    throw new Error(`Не удалось отправить сообщение: ${error.message}`);
  }
}

/**
 * Получает user_ID Max по имени ребёнка
 * @param {string} childName - Имя ребёнка
 * @returns {string|null} user_ID или null
 */
function getMaxUserIdByChildName(childName) {
  if (!childName || typeof childName !== 'string') return null;
  
  const trimmedName = childName.trim();
  if (!trimmedName) return null;
  
  const chatId = findUniversal(
    CONSTANTS.SHEET_NAMES.CLIENTS,
    { "Имя": trimmedName },
    'Max' // столбец с user_ID Max
  );
  
  if (!chatId) return null;
  
  // Убираем лишние символы: пробелы, плюсы в начале
  return String(chatId).trim().replace(/^[\s\+]+/, '');
}


