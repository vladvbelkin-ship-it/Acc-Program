/**
 * Отправляет напоминания о занятиях всем родителям за день.
 */
function sendWhatsAppRemindAttendanceDate(data) {
  const activeSheet = SPREADSHEET.getActiveSheet();
  const childrenData = data.childrenRange.getValues();
  const formattedDate = Utilities.formatDate(data.currentDate, Session.getScriptTimeZone(), 'dd.MM.yyyy');
  
  // Используем Set для отслеживания уникальных детей
  const uniqueChildren = new Set();
  let allContacts = [];
  
  childrenData.forEach((row, index) => {
    const childName = row[0];
    if (!childName || /перерыв|пауза|отмена/i.test(childName)) return;

    // Проверяем, не обрабатывали ли мы уже этого ребенка
    if (uniqueChildren.has(childName)) {
      return; // Пропускаем, если ребенок уже был обработан
    }
    
    // Добавляем ребенка в список обработанных
    uniqueChildren.add(childName);

    const childCellAddress = data.childrenRange.getCell(index + 1, 1).getA1Notation();
    const classTime = findClassTime(childCellAddress, activeSheet);
    const parentData = findParentNamesByKidName(childCellAddress, activeSheet);

    if (parentData.length > 0) {
      parentData.forEach(parent => {
        if (parent.phone) {
          const onlyParentName = parent.name.split(' ')[0];
          const onlyChildName = childName.split(' ')[0];
          const baseMessage = `Здравствуйте, ${onlyParentName}. Напоминаем Вам, что ${onlyChildName} записан(а) на занятие ${formattedDate} в ${classTime} в центре Перемена. Сообщите, пожалуйста, придете ли Вы?`;
          
          // Добавляем контакт с персонализированным сообщением
          allContacts.push({
            name: `${parent.name} (ребенок: ${childName})`,
            phone: parent.phone,
            baseMessage: baseMessage
          });
        } else {
          // Если нет телефона, все равно добавляем для отображения ошибки
          allContacts.push({
            name: `${parent.name} (ребенок: ${childName})`,
            phone: null,
            baseMessage: ''
          });
        }
      });
    }
  });

  if (allContacts.length === 0) {
    logAndAlert('Ошибка', 'Нет контактов', 'Не найдены контакты для отправки напоминаний.');
    return;
  }

  // Создаем модифицированную версию sendShortMessage для работы с разными сообщениями
  showCustomMessages(allContacts);
}

