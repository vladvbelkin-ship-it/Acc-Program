/**
 * Находит все занятия для выбранного ребенка в расписании на текущую неделю.
 * Возвращает массив с информацией: день недели, время, специалист, услуга.
 * @param {string} savedCellAddress - Адрес ячейки с именем ребенка.
 * @returns {Array<{dayOfWeek: string, time: string, specialist: string, service: string}>}
 */
function findChildScheduleForWeek(savedCellAddress) {
  const scheduleSheet = SPREADSHEET.getSheetByName(CONSTANTS.SHEET_NAMES.SCHEDULE);
  if (!scheduleSheet) {
    getUI().alert('Ошибка', 'Лист "Расписание" не найден.', getUI().ButtonSet.OK);
    return [];
  }

  // Получаем имя ребенка из ячейки
  const childName = scheduleSheet.getRange(savedCellAddress).getValue();
  if (!childName) {
    return [];
  }

  const lastRow = scheduleSheet.getLastRow();
  const lastCol = scheduleSheet.getLastColumn();

  if (lastRow < 2 || lastCol < 4) {
    return [];
  }

  const allData = scheduleSheet.getRange(1, 1, lastRow, lastCol).getValues();
  const childSchedule = [];

  // Ищем все "Дата" по всему листу
  for (let r = 0; r < allData.length; r++) {
    for (let c = 0; c < allData[r].length; c++) {
      if (String(allData[r][c]).trim() !== 'Дата') continue;

      const rawDateValue = (c + 1 < lastCol) ? allData[r][c + 1] : null;
      const rawDateStr = String(rawDateValue ?? '').trim();
      
      if (!rawDateStr) continue;

      const dateObj = normalizeDate_(rawDateValue);
      if (!dateObj) continue;

      // Определяем день недели
      const daysOfWeek = ['Вс', 'Пн', 'Вт', 'Ср', 'Чт', 'Пт', 'Сб'];
      const dayOfWeek = daysOfWeek[dateObj.getDay()];

      const timeHeaderRow = findTimeHeaderRow_(allData, r, c);
      if (timeHeaderRow === -1) continue;

      const timeCol = c;
      const specCol = c + 1;
      const childCol = c + 2;
      const serviceCol = c + 3;

      if (serviceCol >= lastCol) continue;

      const startRow = timeHeaderRow + 1;
      const endRowExclusive = findNextDateRowInColumn_(allData, c, timeHeaderRow + 1);

      for (let rr = startRow; rr < endRowExclusive; rr++) {
        const currentChildName = safeCellStr_(allData, rr, childCol);
        
        if (currentChildName === childName) {
          const time = safeCellStr_(allData, rr, timeCol);
          const specialist = safeCellStr_(allData, rr, specCol);
          const service = safeCellStr_(allData, rr, serviceCol);
          
          if (!time || !specialist || !service) continue;
          if (/перерыв|пауза|отмена/i.test(currentChildName)) continue;
          if (/перерыв|пауза|отмена/i.test(service)) continue;

          childSchedule.push({
            dayOfWeek: dayOfWeek,
            time: time,
            specialist: specialist,
            service: service
          });
        }
      }
    }
  }
  return childSchedule;
}

