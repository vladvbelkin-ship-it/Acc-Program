/**
 * Показывает задачи на дату занятия выбранного ребенка.
 * Анализирует всю группу (всех детей) в этот день и формирует задачи.
 * @param {string} savedCellAddress - Адрес ячейки с именем ребенка
 * @param {GoogleAppsScript.Spreadsheet.Sheet} activeSheet - Активный лист
 */
function showTasksForChildDate(savedCellAddress, activeSheet) {
  try {
    // Получаем данные о группе (всех детей за этот день)
    const groupData = getChildrenByDate(savedCellAddress, activeSheet);
    if (!groupData) {
      getUI().alert('Ошибка', 'Не удалось определить дату занятия или найти группу.', getUI().ButtonSet.OK);
      return;
    }
    
    const classDate = groupData.currentDate;
    const dateObj = toDateAny_(classDate);
    if (!dateObj) {
      getUI().alert('Ошибка', 'Не удалось распознать дату занятия.', getUI().ButtonSet.OK);
      return;
    }
    
    const dateStr = Utilities.formatDate(dateObj, SPREADSHEET.getSpreadsheetTimeZone(), "dd.MM.yyyy");
    const dayOfWeek = ['Вс', 'Пн', 'Вт', 'Ср', 'Чт', 'Пт', 'Сб'][dateObj.getDay()];
    
    // Получаем диапазон с детьми и их значения
    const childrenRange = groupData.childrenRange;
    const childrenValues = childrenRange.getValues();
    
    // Собираем задачи
    const tasks = {
      reminders: [],      // Блок 1: напоминания родителям о занятиях
      cancellations: [],  // Блок 2: уведомления специалистам об отменах
      debts: []           // Блок 3: уведомления о задолженностях
    };
    
    // Регулярное выражение для определения пропусков/отмен
    const absenceRe = ABSENCE_RE;
    
    // Получаем данные обо всех строках в этой группе (чтобы достать специалистов и услуги)
    const startRow = childrenRange.getRow();
    const childCol = childrenRange.getColumn();
    const timeCol = childCol - 2;  // Время на 2 колонки левее
    const specCol = childCol - 1;   // Специалист на 1 колонку левее
    const serviceCol = childCol + 1; // Услуга на 1 колонку правее
    
    // Получаем все данные группы
    const timeData = activeSheet.getRange(startRow, timeCol, childrenValues.length, 1).getValues();
    const specData = activeSheet.getRange(startRow, specCol, childrenValues.length, 1).getValues();
    const serviceData = activeSheet.getRange(startRow, serviceCol, childrenValues.length, 1).getValues();
    
    // Обрабатываем каждого ребенка в группе
    for (let i = 0; i < childrenValues.length; i++) {
      const childName = String(childrenValues[i][0] || '').trim();
      if (!childName) continue;
      
      // Пропускаем служебные строки
      if (/перерыв|пауза|окно|отдых/i.test(childName)) continue;
      
      const time = String(timeData[i][0] || '').trim();
      const specialist = String(specData[i][0] || '').trim();
      const service = String(serviceData[i][0] || '').trim();
      
      if (!specialist) continue; // Нет специалиста - пропускаем
      
      // === БЛОК 1 и 2: Анализируем услугу ===
      const isAbsence = absenceRe.test(normalizeTextForMatch_(service));
      
      if (isAbsence) {
        // === БЛОК 2: Отмена / пропуск — уведомить специалиста ===
        // Получаем телефон специалиста
        const specialistPhone = findUniversal(
          CONSTANTS.SHEET_NAMES.STAFF,
          { 'Имя': specialist },
          'Телефон'
        );
        
        tasks.cancellations.push({
          type: 'cancellation',
          specialist: specialist,
          specialistPhone: specialistPhone,
          date: dateStr,
          time: time,
          childName: childName,
          reason: service, // Причина из ячейки "Услуга"
          displayText: `${specialist}  ||  ${dateStr} ${time} ${childName}  ||  ${service}`
        });
      } else {
        // === БЛОК 1: Обычное занятие — напомнить родителям ===
        const parentData = findParentNamesByKidNameByExactName(childName);
        
        if (parentData.length > 0) {
          // Определяем тип занятия (обычное или НПД)
          const isNPD = normalizeTextForMatch_(service).includes('нпд');
          
          parentData.forEach(parent => {
            tasks.reminders.push({
              type: isNPD ? 'npd_reminder' : 'reminder',
              childName: childName,
              parentName: parent.name,
              parentPhone: parent.phone,
              date: dateStr,
              time: time,
              service: service,
              specialist: specialist,
              displayText: `${childName}  ||  ${parent.name}  ||  ${isNPD ? 'напомнить о НПД' : 'напомнить о занятии'}`
            });
          });
        }
      }
    }
    
    // === БЛОК 3: Проверка балансов для ВСЕХ детей ===
    const allDebtors = findClientsWithNegativeBalance();
    
    allDebtors.forEach(client => {
      const parentData = findParentNamesByKidNameByExactName(client.childName);
      
      if (parentData.length > 0) {
        parentData.forEach(parent => {
          tasks.debts.push({
            type: 'debt',
            childName: client.childName,
            parentName: parent.name,
            parentPhone: parent.phone,
            balance: client.balance,
            displayText: `${client.childName}  ||  ${parent.name}  ||  сообщить о задолженности (${formatNumber(client.balance)} руб.)`
          });
        });
      } else {
        tasks.debts.push({
          type: 'debt',
          childName: client.childName,
          parentName: 'Родитель не найден',
          parentPhone: null,
          balance: client.balance,
          displayText: `${client.childName}  ||  Родитель не найден  ||  задолженность ${formatNumber(client.balance)} руб.`
        });
      }
    });
    
    // Показываем диалоговое окно с задачами
    showTasksForDateDialog(tasks, dateStr, dayOfWeek, 
                          `на основе занятия ${childrenValues[0][0]}`);
    
  } catch (error) {
    logAndAlert('Ошибка', 'Не удалось сформировать задачи', error.toString());
  }
}

/**
 * Находит родителей по точному имени ребенка (без использования адреса ячейки).
 * @param {string} childName - Имя ребенка
 * @returns {Array<{name: string, phone: string|null}>}
 */
function findParentNamesByKidNameByExactName(childName) {
  if (!childName) return [];
  
  // ИСПРАВЛЕНИЕ: используем getSourceSpreadsheet() вместо checkSheetExists()
  const ss = getSourceSpreadsheet();
  const clientsSheet = ss.getSheetByName(CONSTANTS.SHEET_NAMES.CLIENTS);
  if (!clientsSheet) {
    throw new Error('Лист "Клиенты" не найден в таблице 2!');
  }
  
  const lastRow = clientsSheet.getLastRow();

  // Обновляем кеш, если данные изменились
  if (__PARENTS_CACHE__.byChild === null || __PARENTS_CACHE__.lastRow !== lastRow) {
    const data = clientsSheet.getDataRange().getValues();
    const headers = data[1].map(String);
    const nameCol = headers.indexOf('Имя');
    const parentCol = headers.indexOf('Имя родителя');
    const phoneCol = headers.indexOf('Телефон');

    const map = new Map();
    if (nameCol !== -1 && parentCol !== -1) {
      for (let i = 2; i < data.length; i++) {
        const key = String(data[i][nameCol] || '').trim();
        if (!key) continue;
        const parentName = data[i][parentCol];
        const phone = data[i][phoneCol] ? String(data[i][phoneCol]).trim() : null;
        if (!parentName) continue;
        if (!map.has(key)) map.set(key, []);
        const arr = map.get(key);
        const pk = `${parentName}|${phone}`;
        if (!arr.some(p => `${p.name}|${p.phone}` === pk)) {
          arr.push({ name: parentName, phone });
        }
      }
    }
    __PARENTS_CACHE__.byChild = map;
    __PARENTS_CACHE__.lastRow = lastRow;
  }

  return __PARENTS_CACHE__.byChild.get(childName) || [];
}

/**
 * Находит всех клиентов с отрицательным балансом в листе "Баланс".
 * Имя ребенка в столбце A, баланс в столбце F.
 * @returns {Array<{childName: string, balance: number}>}
 */
function findClientsWithNegativeBalance() {
  const balanceSheet = checkSheetExists(CONSTANTS.SHEET_NAMES.BALANCE);
  const lastRow = balanceSheet.getLastRow();
  if (lastRow < 2) return [];

  if (__BALANCE_CACHE__.debtors === null || __BALANCE_CACHE__.lastRow !== lastRow) {
    const names = balanceSheet.getRange(2, 1, lastRow - 1, 1).getValues();
    const balances = balanceSheet.getRange(2, 6, lastRow - 1, 1).getValues();
    const result = [];
    for (let i = 0; i < names.length; i++) {
      const childName = String(names[i][0] || '').trim();
      if (!childName) continue;
      const balanceRaw = balances[i][0];
      let balance = 0;
      if (typeof balanceRaw === 'number') balance = balanceRaw;
      else if (typeof balanceRaw === 'string') {
        balance = parseFloat(balanceRaw.replace(/\s/g, '').replace(',', '.'));
      }
      if (isFinite(balance) && balance < -1) {
        result.push({ childName, balance });
      }
    }
    __BALANCE_CACHE__.debtors = result;
    __BALANCE_CACHE__.lastRow = lastRow;
  }
  return __BALANCE_CACHE__.debtors;
}

