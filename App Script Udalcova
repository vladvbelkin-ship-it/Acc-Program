/**
 * Генерирует HTML-окно со ссылками для отправки сообщений в WhatsApp.
 * @param {Array<{name: string, phone: string|null}>} contacts - Массив контактов.
 * @param {string} baseMessage - Текст сообщения без приветствия.
 */
function sendShortMessage(contacts, baseMessage) {
  if (!Array.isArray(contacts) || contacts.length === 0) {
    logAndAlert('Ошибка', 'Нет контактов', 'Не найдены контакты для отправки сообщения.');
    return;
  }

  // Определяем название мессенджера по базовому URL
  const messengerName = MESSENGER_BASE_URL.includes('t.me') ? 'Telegram' : 'WhatsApp';

  const linksHtml = contacts.map(contact => {
    if (!contact.phone) {
      return `<p style="color: red;">❌ ${contact.name} - телефон не найден</p>`;
    }
    const onlyName = String(contact.name).split(' ')[0];
    const finalMessage = `Здравствуйте, ${onlyName}. ${baseMessage}`;
    const encodedMessage = encodeURIComponent(finalMessage);
    // Используем константу MESSENGER_BASE_URL
    const messageLink = `${MESSENGER_BASE_URL}${contact.phone}?text=${encodedMessage}`;
    //const whatsappLink = `https://wa.me/${contact.phone}?text=${encodedMessage}`; WA больше не работает
    return `<p><a href="${messageLink}" target="_blank">Отправить сообщение: ${contact.name}</a></p>`;
  }).join('');

  const html = HtmlService.createHtmlOutput(`
    <div style="font-family: sans-serif;">
      <h3>Нажмите на ссылки для отправки:</h3>
      ${linksHtml}
    </div>
  `).setWidth(500).setHeight(300);

  // Динамический заголовок в зависимости от мессенджера
  getUI().showModalDialog(html, `Отправка сообщений ${messengerName}`);
}

/**
 * Отправляет сообщения для диапазона детей.
 */
