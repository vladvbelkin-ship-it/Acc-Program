/**
* Добавляет запись о посещении. Работает в трёх режимах:
*  - 'interactive' - с диалогами для пользователя (для одиночного добавления).
*  - 'batch'       - без диалогов, с записью в лист (массовая обработка).
*  - 'collect'     - без диалогов, БЕЗ записи в лист. Возвращает dataToInsert
*                    в результате — вызывающая функция сама сделает пакетную запись.
*
* @param {string} savedCellAddress - Адрес ячейки с именем ребёнка.
* @param {string|null} flagMessage - Если задана, показывает итоговое сообщение (только в interactive).
* @param {Date|string|null} inputDate - Явно заданная дата занятия (опционально).
* @param {GoogleAppsScript.Spreadsheet.Sheet} activeSheet - Лист "Расписание".
* @param {string} mode - Режим работы: 'interactive' | 'batch' | 'collect'.
* @returns {object} { success, costWasMissing, childName, service, dataToInsert?, reason? }
*/
function addAttendance(savedCellAddress, flagMessage, inputDate, activeSheet, mode = 'interactive') {
  const isCollect = (mode === 'collect');
  const isInteractive = (mode === 'interactive');

  const childName = activeSheet.getRange(savedCellAddress).getValue();

  let classDate;
  if (inputDate) {
    classDate = toDateAny_(inputDate);
  } else {
    const dateFromSheet = findClassDate(savedCellAddress, activeSheet);
    classDate = toDateAny_(dateFromSheet);
  }
  if (!classDate) {
    if (isInteractive) {
      logAndAlert('Ошибка', 'Дата занятия не найдена', 'Не удалось определить дату занятия. Проверьте блок "Дата".');
    }
    return { success: false, reason: 'Дата занятия не распознана' };
  }

  const formattedDate = Utilities.formatDate(classDate, SPREADSHEET.getSpreadsheetTimeZone(), "dd.MM.yy");
  const dayOfWeek = ['Вс', 'Пн', 'Вт', 'Ср', 'Чт', 'Пт', 'Сб'][classDate.getDay()];

  const pedagoguesInfo = findPedagogue(savedCellAddress, activeSheet);
  if (pedagoguesInfo.length === 0) {
    if (isInteractive) logAndAlert('Ошибка', 'Педагог не найден', 'Проверьте расписание и лист "Сотрудники".');
    return { success: false, reason: 'Педагог не найден' };
  }

  const countChildren = countChildrenInGroup(savedCellAddress, activeSheet);
  const sessionTypeValue = sessionType(savedCellAddress, activeSheet);
  if (!sessionTypeValue) {
    if (isInteractive) logAndAlert('Ошибка', 'Услуга не найдена', `Услуга для ребенка "${childName}" не указана в расписании.`);
    return { success: false, reason: 'Услуга не указана' };
  }

  const classTime = findClassTime(savedCellAddress, activeSheet);

  // === Расчёт стоимости занятия ===
  const isGroup = countChildren > 1;
  const groupType = isGroup ? "Группа" : "Индив";

  const packetCost = findUniversal(
    CONSTANTS.SHEET_NAMES.CLIENTS,
    { "Имя": childName, "Услуга": sessionTypeValue, "Группа/Индива": groupType },
    'Стоимость абонемента'
  );
  const singleCost = findUniversal(
    CONSTANTS.SHEET_NAMES.CLIENTS,
    { "Имя": childName, "Услуга": sessionTypeValue, "Группа/Индива": groupType },
    'Стоимость разового'
  );

  let finalCost = 0;
  let costWasMissing = false;
  if (packetCost && packetCost > 0) {
    finalCost = packetCost / 8;
  } else if (singleCost && singleCost > 0) {
    finalCost = singleCost;
  } else {
    finalCost = 0;
    costWasMissing = true;
    if (isInteractive) {
      const groupText = isGroup ? `Групповое (${countChildren} чел.)` : "Индивидуальное";
      const response = getUI().alert(
        'Внимание!',
        `Стоимость услуги "${sessionTypeValue}" (${groupText}) для ребенка "${childName}" не найдена в листе "Клиенты".\nДобавить посещение с нулевой стоимостью?`,
        getUI().ButtonSet.YES_NO
      );
      if (response !== getUI().Button.YES) {
        Logger.log(`Пользователь отменил добавление занятия для ${childName} из-за нулевой стоимости.`);
        return { success: false, costWasMissing: true, childName, service: sessionTypeValue, reason: 'Отменено пользователем' };
      }
    }
  }

  Logger.log(`Ребенок: ${childName}, Услуга: ${sessionTypeValue}, Тип: ${groupType}, Детей в группе: ${countChildren}, Стоимость: ${finalCost}`);

  // === Формируем строки для вставки ===
  const dataToInsert = pedagoguesInfo.map(pedagogue => {
    const salaryRaw = findUniversal(
      CONSTANTS.SHEET_NAMES.STAFF,
      { 'Имя': pedagogue.name, 'Услуга сокращ.': sessionTypeValue },
      `ЗП ${countChildren} чел`
    );
    const salaryNum = (typeof salaryRaw === 'number') ? salaryRaw : parseNumber(String(salaryRaw ?? ''));
    const pedagogueSalary = (isFinite(salaryNum) && countChildren > 0) ? (salaryNum / countChildren) : 0;
    return [
      formattedDate,
      dayOfWeek,
      classTime,
      childName,
      finalCost,
      pedagogue.name,
      pedagoguesInfo.length,
      sessionTypeValue,
      countChildren,
      pedagogueSalary || 0,
      1 / pedagoguesInfo.length
    ];
  });

  // === В режиме 'collect' — НЕ пишем в лист, возвращаем данные ===
  if (isCollect) {
    // Подсветку ячейки тоже пропускаем — это массовый режим
    return {
      success: true,
      costWasMissing,
      childName,
      service: sessionTypeValue,
      dataToInsert
    };
  }

  // === Обычная запись в лист (interactive / batch) ===
  if (dataToInsert.length > 0) {
    const sheet = checkSheetExists(CONSTANTS.SHEET_NAMES.ATTENDANCE);
    sheet.getRange(sheet.getLastRow() + 1, 1, dataToInsert.length, dataToInsert[0].length).setValues(dataToInsert);
    Logger.log(`Добавлено ${dataToInsert.length} строк о посещении для ${childName}.`);
  }

  if (flagMessage) {
    const message = dataToInsert.map(row =>
      `Ребенок: ${row[3]}\nДата: ${row[0]}, Время: ${row[2]}\nУслуга: ${row[7]}, Стоимость: ${row[4]}\n` +
      `Педагог: ${row[5]}, Начислено: ${row[9]}`
    ).join('\n');
    logAndAlert(`Занятие добавлено: ${childName}`, 'Добавлено занятие', message);
  }

  activeSheet.getRange(savedCellAddress).setBackground(CONSTANTS.COLOR_ATTENDED_KID);

  return { success: true, costWasMissing, childName, service: sessionTypeValue };
}

/**
 * Добавляет запись об оплате в лист "Оплаты".
 * @param {string} savedCellAddress - Адрес ячейки с именем ребенка.
 * @param {GoogleAppsScript.Spreadsheet.Sheet} activeSheet - Активный лист.
 */
function addPayment(savedCellAddress, activeSheet) {
  const childName = activeSheet.getRange(savedCellAddress).getValue();
  
  const amountResponse = getUI().prompt('Сумма оплаты:', `Введите сумму для "${childName}"`, getUI().ButtonSet.OK_CANCEL);
  if (amountResponse.getSelectedButton() !== getUI().Button.OK) return;
  const amount = parseFloat(amountResponse.getResponseText().replace(',', '.'));
  if (isNaN(amount) || amount <= 0) {
    logAndAlert('Ошибка', 'Некорректная сумма', 'Введите положительное число.');
    return;
  }

  const dateResponse = getUI().prompt('Дата оплаты (ДД.ММ.ГГГГ):', 'Оставьте пустым для сегодняшней даты.', getUI().ButtonSet.OK_CANCEL);
  if (dateResponse.getSelectedButton() !== getUI().Button.OK) return;
  
  let paymentDate;
  const dateInput = dateResponse.getResponseText().trim();
  if (dateInput) {
    const [day, month, year] = dateInput.split('.');
    paymentDate = new Date(year, month - 1, day);
    if (isNaN(paymentDate.getTime())) {
      logAndAlert('Ошибка', 'Некорректная дата', 'Введите дату в формате ДД.ММ.ГГГГ.');
      return;
    }
  } else {
    paymentDate = new Date();
  }

  const parentName = findUniversal(CONSTANTS.SHEET_NAMES.CLIENTS, {"Имя": childName}, 'Имя родителя');
  const sheet = checkSheetExists(CONSTANTS.SHEET_NAMES.PAYMENTS);
  const formattedDate = Utilities.formatDate(paymentDate, SPREADSHEET.getSpreadsheetTimeZone(), 'dd.MM.yy');
  sheet.appendRow([formattedDate, childName, parentName || '', amount]);

  logAndAlert('Оплата добавлена', 'Успех', `Добавлена оплата для "${childName}" на сумму ${amount} руб. от ${formattedDate}.`);
}

// =================================== УНИВЕРСАЛЬНЫЕ И ВСПОМОГАТЕЛЬНЫЕ ФУНКЦИИ ===================================

/**
 * Универсальная функция поиска значения в листе по нескольким критериям.
 * @param {string} sheetName - Имя листа для поиска.
 * @param {Object.<string, any>} criteria - Объект, где ключ - имя столбца, значение - искомое значение.
 * @param {string} targetColumnName - Имя столбца, из которого нужно вернуть значение.
 * @returns {any|null} Найденное значение или null.
 */
/**
 * Универсальный поиск по листу: находит строку по набору критериев и возвращает значение из целевой колонки.
 *
 * КЛЮЧЕВЫЕ ИДЕИ:
 * 1) Кэшируем заголовки и индексы колонок на уровне выполнения скрипта (в памяти).
 * 2) Кэшируем "индекс" значений (Map) для частых запросов вида: (sheetName, criteria, targetColumnName).
 *    Это ускоряет повторные findUniversal в циклах (batch).
 * 3) Нормализуем заголовки (учёт \n, <br>, слешей).
 *
 * ВАЖНО:
 * - Это кэш в пределах одного запуска скрипта. Между запусками он не сохраняется.
 * - Для "массовых" операций лучше строить отдельный индекс заранее, но этот вариант уже ощутимо ускорит.
 */

// ---- ВНУТРЕННИЕ КЭШИ (на время выполнения) ----
const __FU_CACHE__ = {
  headersBySheet: new Map(),
  colIndexBySheet: new Map(),
  dataBySheet: new Map(),
  findResultCache: new Map(),
  sourceId: null  // ← ДОБАВИТЬ ЭТУ СТРОКУ
};

/** Нормализует заголовок: переносы/BR -> '/', двойные слеши схлопнуть, trim */
function __fuNormalizeHeader_(s) {
  return String(s ?? '')
    .replace(/<br\s*\/?>/gi, '/')
    .replace(/\n/g, '/')
    .replace(/\/\//g, '/')
    .trim();
}

/** Нормализует значение для сравнения в findUniversal: trim, без лишних пробелов */
function __fuNormValue_(v) {
  return String(v ?? '').trim();
}

/** Пробуем привести строковые числа вида "17 700" / "17 700" / "17,5" -> number */
function __fuMaybeNumber_(v) {
  if (typeof v === 'number') return v;
  if (typeof v !== 'string') return v;

  const s = v.replace(/[\s\u00A0]/g, '').replace(',', '.');
  const num = parseFloat(s);
  return isNaN(num) ? v : num;
}

/**
 * Грузит data + ищет строку заголовков (в первых 4 строках) и кэширует.
 * Заголовок определяется наличием хотя бы одного столбца из criteria.
 */
function __fuPrimeSheet_(sheetName, criteriaKeys) {
  // Проверяем, нужно ли обновить кэш (если изменилась таблица-источник)
  const currentSourceId = SOURCE_SPREADSHEET_ID;
  if (__FU_CACHE__.sourceId !== currentSourceId) {
    __FU_CACHE__.headersBySheet = new Map();
    __FU_CACHE__.colIndexBySheet = new Map();
    __FU_CACHE__.dataBySheet = new Map();
    __FU_CACHE__.findResultCache = new Map();
    __FU_CACHE__.sourceId = currentSourceId;
  }

  if (__FU_CACHE__.headersBySheet.has(sheetName) && __FU_CACHE__.dataBySheet.has(sheetName)) {
    return;
  }

  // ИСПРАВЛЕНИЕ: используем getSourceSpreadsheet() вместо активной таблицы
  const ss = getSourceSpreadsheet();
  const sheet = ss.getSheetByName(sheetName);
  if (!sheet) {
    throw new Error(`Лист "${sheetName}" не найден в таблице 2!`);
  }

  const data = sheet.getDataRange().getValues();
  __FU_CACHE__.dataBySheet.set(sheetName, data);

  let headers = [];
  let headerRowIndex = -1;

  for (let i = 0; i < Math.min(4, data.length); i++) {
    const row = data[i].map(cell => __fuNormalizeHeader_(cell));
    const hasAny = criteriaKeys.some(k => row.includes(k));
    if (hasAny) {
      headers = row;
      headerRowIndex = i;
      break;
    }
  }

  if (headerRowIndex === -1) {
    __FU_CACHE__.headersBySheet.set(sheetName, { headers: [], headerRowIndex: -1 });
    __FU_CACHE__.colIndexBySheet.set(sheetName, new Map());
    return;
  }

  const map = new Map();
  headers.forEach((h, idx) => {
    if (!h) return;
    if (!map.has(h)) map.set(h, idx);
  });

  __FU_CACHE__.headersBySheet.set(sheetName, { headers, headerRowIndex });
  __FU_CACHE__.colIndexBySheet.set(sheetName, map);
}

/**
 * Делает стабильный ключ под кэш результата:
 * sheetName + targetColumnName + JSON(criteria sorted keys)
 */
function __fuMakeKey_(sheetName, criteria, targetColumnName) {
  const keys = Object.keys(criteria).sort();
  const obj = {};
  keys.forEach(k => obj[k] = __fuNormValue_(criteria[k]));
  return `${sheetName}||${targetColumnName}||${JSON.stringify(obj)}`;
}

/**
 * Универсальная функция поиска значения в листе по нескольким критериям.
 * @param {string} sheetName - Имя листа для поиска.
 * @param {Object.<string, any>} criteria - Объект, где ключ - имя столбца, значение - искомое значение.
 * @param {string} targetColumnName - Имя столбца, из которого нужно вернуть значение.
 * @returns {any|null} Найденное значение или null.
 */
function findUniversal(sheetName, criteria, targetColumnName) {
  const criteriaKeys = Object.keys(criteria || {});
  if (criteriaKeys.length === 0) return null;

  // Проверяем, нужно ли обновить кэш (если изменилась таблица-источник)
  const currentSourceId = SOURCE_SPREADSHEET_ID;
  if (__FU_CACHE__.sourceId !== currentSourceId) {
    __FU_CACHE__.headersBySheet = new Map();
    __FU_CACHE__.colIndexBySheet = new Map();
    __FU_CACHE__.dataBySheet = new Map();
    __FU_CACHE__.findResultCache = new Map();
    __FU_CACHE__.sourceId = currentSourceId;
  }

  // кэш результата (часто findUniversal вызывается много раз с одинаковыми аргументами)
  const cacheKey = __fuMakeKey_(sheetName, criteria, targetColumnName);
  if (__FU_CACHE__.findResultCache.has(cacheKey)) {
    return __FU_CACHE__.findResultCache.get(cacheKey);
  }

  // загрузка data + заголовков
  __fuPrimeSheet_(sheetName, criteriaKeys);

  const meta = __FU_CACHE__.headersBySheet.get(sheetName);
  const data = __FU_CACHE__.dataBySheet.get(sheetName) || [];

  if (!meta || meta.headerRowIndex === -1) {
    __FU_CACHE__.findResultCache.set(cacheKey, null);
    return null;
  }

  const colMap = __FU_CACHE__.colIndexBySheet.get(sheetName) || new Map();

  // индексы колонок по критериям
  const searchCols = {};
  for (const colName of criteriaKeys) {
    const idx = colMap.get(colName);
    if (typeof idx !== 'number') {
      __FU_CACHE__.findResultCache.set(cacheKey, null);
      return null;
    }
    searchCols[colName] = idx;
  }

  // индекс целевой колонки
  const targetIdx = colMap.get(targetColumnName);
  if (typeof targetIdx !== 'number') {
    __FU_CACHE__.findResultCache.set(cacheKey, null);
    return null;
  }

  // поиск строк данных
  for (let r = meta.headerRowIndex + 1; r < data.length; r++) {
    const row = data[r];
    if (!row || row.every(cell => cell === null || cell === '' || cell === undefined)) continue;

    const isMatch = criteriaKeys.every(colName => {
      const idx = searchCols[colName];
      const cellStr = __fuNormValue_(row[idx]);
      const critStr = __fuNormValue_(criteria[colName]);
      return cellStr === critStr;
    });

    if (!isMatch) continue;

    let result = row[targetIdx];

    // Приводим строковые числа вида "17 700" -> 17700
    result = __fuMaybeNumber_(result);

    // Пустое -> null
    const finalRes = (result === '' || typeof result === 'undefined') ? null : result;

    __FU_CACHE__.findResultCache.set(cacheKey, finalRes);
    return finalRes;
  }

  __FU_CACHE__.findResultCache.set(cacheKey, null);
  return null;
}

/** Оптимизированный поиск даты: читает только последние 35 строк вместо всего столбца */
function findClassDate(savedCellAddress, activeSheet) {
  const range = activeSheet.getRange(savedCellAddress);
  const row = range.getRow();
  const col = range.getColumn() - 2;
  if (col < 1) return null;

  // Читаем только блок, где реально может быть "Дата"
  const searchHeight = Math.min(row, 35);
  const startRow = row - searchHeight + 1;

  const data = activeSheet.getRange(startRow, col, searchHeight, 2).getValues();
  for (let i = data.length - 1; i >= 0; i--) {
    if (String(data[i][0]).trim() === "Дата") {
      return data[i][1];
    }
  }
  return null;
}

/**
 * Находит педагога(ов) для занятия.
 * @returns {Array<{name: string, phone: string|null}>} Массив объектов педагогов.
 */
function findPedagogue(savedCellAddress, activeSheet) {
  const range = activeSheet.getRange(savedCellAddress);
  const row = range.getRow();
  const col = range.getColumn() - 1;
  if (col < 1) return [];

  const columnData = activeSheet.getRange(1, col, row, 1).getValues();
  let pedagoguesNames = [];
  for (let i = columnData.length - 1; i >= 0; i--) {
    if (columnData[i][0]) {
      pedagoguesNames = String(columnData[i][0]).split('/').map(p => p.trim());
      break;
    }
  }
  if (pedagoguesNames.length === 0) return [];

  const staffSheet = checkSheetExists(CONSTANTS.SHEET_NAMES.STAFF);
  const lastRow = staffSheet.getLastRow();

  // Кеш по сотрудникам
  if (__STAFF_CACHE__.byName === null || __STAFF_CACHE__.lastRow !== lastRow) {
    const staffData = staffSheet.getDataRange().getValues();
    const headers = staffData[1].map(String);
    const nameCol = headers.indexOf('Имя');
    const phoneCol = headers.indexOf('Телефон');
    const map = new Map();
    for (const row of staffData) {
      const name = row[nameCol];
      if (name) map.set(String(name), row[phoneCol] || null);
    }
    __STAFF_CACHE__.byName = map;
    __STAFF_CACHE__.lastRow = lastRow;
  }

  return pedagoguesNames.map(name => ({
    name,
    phone: __STAFF_CACHE__.byName.get(name) ?? null
  })).filter(p => p.name);
}

/**
 * Находит данные родителей по имени ребенка (с использованием адреса ячейки).
 * @returns {Array<{name: string, phone: string|null}>} Массив объектов родителей.
