            display: inline-block;
            background: #5f6368;
            color: white;
            padding: 0px 8px;
            border-radius: 12px;
            font-size: 12px;
            margin-left: 8px;
          }
          .count-badge.error { background: #d93025; }
          .count-badge.ok { background: #1e8e3e; }
          .ok-text {
            color: #1e8e3e;
            font-size: 14px;
            padding-left: 12px;
          }
          .error-text {
            color: #d93025;
            font-size: 14px;
            padding-left: 12px;
          }
        </style>
      </head>
      <body>
        <div class="container">
          <div class="summary">
            <h3>Отчет о проверке целостности данных</h3>
            <p>
              Найдено проблем: <strong style="color: ${totalIssues > 0 ? '#d93025' : '#1e8e3e'};">${totalIssues}</strong>
              ${totalIssues > 0 ? ' (требуется исправление)' : ' (все в порядке)'}
            </p>
          </div>
          
          <!-- 1. Дети в Расписании, которых нет в Клиенты -->
          <div class="issue-section">
            <h4 class="${missingClientsCount > 0 ? 'error' : 'ok'}">
              Дети в Расписание, которых нет в Клиенты
              <span class="count-badge ${missingClientsCount > 0 ? 'error' : 'ok'}">${missingClientsCount}</span>
            </h4>
            ${missingClientsCount > 0 ? 
              `<div class="issue-list">${result.missingInClients.map(name => `<div class="issue-item">${name}</div>`).join('')}</div>` :
              `<div class="ok-text">Все дети из расписания присутствуют в клиентах</div>`
            }
          </div>
          
          <!-- 2. Дети в Клиенты, которых нет в Баланс -->
          <div class="issue-section">
            <h4 class="${missingBalanceCount > 0 ? 'error' : 'ok'}">
              Дети в Клиенты, которых нет в Баланс
              <span class="count-badge ${missingBalanceCount > 0 ? 'error' : 'ok'}">${missingBalanceCount}</span>
            </h4>
            ${missingBalanceCount > 0 ? 
              `<div class="issue-list">${result.missingInBalance.map(name => `<div class="issue-item">${name}</div>`).join('')}</div>` :
              `<div class="ok-text">Все дети из клиентов присутствуют в балансе</div>`
            }
          </div>
          
          <!-- 3. Дубли в Посещениях -->
          <div class="issue-section">
            <h4 class="${dupVisitsCount > 0 ? 'error' : 'ok'}">
              Дубли в Посещения
              <span class="count-badge ${dupVisitsCount > 0 ? 'error' : 'ok'}">${dupVisitsCount}</span>
            </h4>
            ${dupVisitsCount > 0 ? 
              `<div class="issue-list">${result.duplicateVisits.map(d => 
                `<div class="duplicate-item">
                  <span class="rows">[${d.rows}]</span>
                  <span class="content">${d.content}</span>
                </div>`
              ).join('')}</div>` :
              `<div class="ok-text">Дубли в Посещения не обнаружены</div>`
            }
          </div>
          
          <!-- 4. Дубли в Оплатах -->
          <div class="issue-section">
            <h4 class="${dupPaymentsCount > 0 ? 'error' : 'ok'}">
              Дубли в Оплаты
              <span class="count-badge ${dupPaymentsCount > 0 ? 'error' : 'ok'}">${dupPaymentsCount}</span>
            </h4>
            ${dupPaymentsCount > 0 ? 
              `<div class="issue-list">${result.duplicatePayments.map(d => 
                `<div class="duplicate-item">
                  <span class="rows">[${d.rows}]</span>
                  <span class="content">${d.content}</span>
                </div>`
              ).join('')}</div>` :
              `<div class="ok-text">Дубли в Оплаты не обнаружены</div>`
            }
          </div>

          <!-- 5. Дубли в Баланс -->
          <div class="issue-section">
            <h4 class="${dupBalanceCount > 0 ? 'error' : 'ok'}">
              Дубли в Баланс
              <span class="count-badge ${dupBalanceCount > 0 ? 'error' : 'ok'}">${dupBalanceCount}</span>
            </h4>
            ${dupBalanceCount > 0 ? 
              `<div class="issue-list">${result.duplicateBalance.map(d => 
                `<div class="duplicate-item">[${d.rows}] | ${d.childName}</div>`
              ).join('')}</div>` :
              `<div class="ok-text">Дубли в Баланс не обнаружены</div>`
            }
          </div>
          
          <!-- 6. Дубли в Клиенты -->
          <div class="issue-section">
            <h4 class="${dupClientsCount > 0 ? 'error' : 'ok'}">
              Дубли в Клиенты (по Имя + Группа/Индива + Услуга)
              <span class="count-badge ${dupClientsCount > 0 ? 'error' : 'ok'}">${dupClientsCount}</span>
            </h4>
            ${dupClientsCount > 0 ? 
              `<div class="issue-list">${result.duplicateClients.map(d => 
                `<div class="duplicate-item">
                  [${d.rows}] | ${d.childName} | ${d.groupType} | ${d.service}
                </div>`
              ).join('')}</div>` :
              `<div class="ok-text">Дубли в Клиенты не обнаружены</div>`
            }
          </div>
        </div>
      </body>
    </html>
  `;
  
  const html = HtmlService.createHtmlOutput(htmlContent).setWidth(800).setHeight(700);
  ui.showModalDialog(html, 'Отчет о проверке целостности');
}
